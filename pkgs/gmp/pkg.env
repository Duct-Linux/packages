# gmp -- generated by tools/gen-recipes.sh, safe to edit.
# Source pins come from ../versions.env so a bump is one file.

SRC_URL=$GMP_URL
SRC_SHA256=$GMP_SHA256
SRC_DIR=$GMP_SRCDIR

CONFIGURE_ARGS="--disable-nls"

# gcc 15 defaults to C23, where `void g(){}` declares a function taking no
# arguments. gmp 6.3.0's "long long reliability" probe declares g that way and
# then calls it with six arguments, so configure concludes there is no working
# compiler. LFS never sees this because it builds gmp in-tree with gcc rather
# than as its own package.
CFLAGS="-O2 -std=gnu17"
