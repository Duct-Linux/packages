# cantarell-fonts -- the font GNOME's interface is specified in.
#
# Not cosmetic in the way a font usually is: gsettings-desktop-schemas names
# Cantarell as the interface font, and with no font by that name fontconfig
# substitutes whatever it can find -- on a live ISO with no other fonts
# installed, that is nothing, and labels render as empty boxes.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://download.gnome.org/sources/cantarell-fonts/0.303/cantarell-fonts-0.303.1.tar.xz
SRC_SHA256=f9463a0659c63e57e381fdd753cf1929225395c5b49135989424761830530411
SRC_DIR=cantarell-fonts-0.303.1

PKG_ARCH=any
