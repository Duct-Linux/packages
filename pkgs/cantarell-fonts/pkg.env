# cantarell-fonts -- the font GNOME's interface is specified in.
#
# Not cosmetic in the way a font usually is: gsettings-desktop-schemas names
# Cantarell as the interface font, and with no font by that name fontconfig
# substitutes whatever it can find -- on a live ISO with no other fonts
# installed, that is nothing, and labels render as empty boxes.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://download.gnome.org/sources/cantarell-fonts/0.303/cantarell-fonts-0.303.1.tar.xz
SRC_SHA256=f9463a0659c63e57e381fdd753cf1929225395c5b49135989424761830530411
SRC_DIR=cantarell-fonts-0.303.1

# -Duseprebuilt=true installs prebuilt/Cantarell-VF.otf, which upstream ships in
# the release tarball, instead of regenerating it from the source outlines.
#
# Building from source needs psautohint, which is a Python hinting tool with a
# C extension and a fonttools dependency chain behind it -- a substantial amount
# of packaging to reproduce, byte for byte, a font the tarball already contains
# and which upstream produced with the same script. A distribution that intends
# to modify the outlines would want the source path; this one ships the font.
#
# buildappstream is off because it needs appstreamcli to validate the metainfo,
# and a font's metadata is not worth an ordering constraint on appstream.
MESON_ARGS="-Duseprebuilt=true -Dbuildappstream=false"

PKG_ARCH=any
