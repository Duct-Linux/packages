# libdisplay-info -- EDID and DisplayID parsing. Required, unconditionally, by
# weston's DRM backend.
#
# PINNED TO THE 0.2 SERIES BY WESTON, NOT BY PREFERENCE, and read from the code
# that imposes it rather than from a changelog. weston 14.0.2,
# libweston/backend-drm/meson.build:
#
#     dep_libdisplay_info = dependency('libdisplay-info', version: ['>= 0.1.1', '< 0.3.0'],
#
# An UPPER bound, which is the unusual half and the one that will catch anyone
# bumping this package on autopilot: 0.3.0 already exists upstream and Debian sid
# ships it, so a bare floor would admit a version that fails weston's configure.
# Debian trixie independently pairs weston 14.0.2 with libdisplay-info 0.2.0 --
# a different party arriving at the same pairing, which is corroboration rather
# than a restatement.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://gitlab.freedesktop.org/emersion/libdisplay-info/-/releases/0.2.0/downloads/libdisplay-info-0.2.0.tar.xz
SRC_SHA256=5a2f002a16f42dd3540c8846f80a90b8f4bdcd067a94b9d2087bc2feae974176
SRC_DIR=libdisplay-info-0.2.0

# NO MESON_ARGS, AND THAT IS A FINDING RATHER THAN AN OMISSION. This release
# ships NO meson_options.txt at all -- the only get_option() in meson.build is
# install_dir: get_option('includedir'). There is nothing to decide, and saying
# so explicitly is the point: "no options" and "nobody looked at the options"
# are indistinguishable in a recipe unless one of them is written down.
MESON_ARGS=""

# WHERE pnp.ids COMES FROM, AND WHICH PART OF IT IS SILENT. meson.build:
#
#     dep_hwdata = dependency('hwdata', required: false, native: true)
#     if dep_hwdata.found()
#         hwdata_dir = dep_hwdata.get_variable(pkgconfig: 'pkgdatadir')
#         pnp_ids = files(hwdata_dir / 'pnp.ids')
#     else
#         pnp_ids = files('/usr/share/hwdata/pnp.ids')
#     endif
#     pnp_id_table = custom_target('pnp-id-table.c', command: [gen_search_table, pnp_ids, ...])
#
# The vendor table is COMPILED INTO the library, so hwdata is a BUILD dependency
# and nothing reads pnp.ids at run time.
#
# required:false looks like the silent path and mostly is not: if the .pc is
# missing the build falls back to a hardcoded /usr/share/hwdata/pnp.ids, and if
# that file is absent too, meson's files() raises at configure time. Absence is
# loud.
#
# WHAT IS SILENT IS TRUNCATION, and this is measured rather than reasoned. Given
# an EMPTY pnp.ids, tool/gen-search-table.py EXITS 0 and writes a 26-line
# pnp-id-table.c containing zero vendor entries. The library then builds, links,
# installs and names no monitor manufacturer -- a cosmetic-looking fault in a
# package whose entire job is decoding monitor metadata, with nothing failing
# anywhere to prompt anyone to look.
#
# So install.sh asserts the GENERATED TABLE has a plausible number of entries.
# That assertion sits on the OUTCOME, which every cause converges on: a missing
# .pc, a truncated pnp.ids, a fallback that found something useless. Duct's
# hwdata asserts only that pci.ids was installed, so "hwdata built successfully"
# is not evidence that the file this package needs is intact -- two assertions at
# two ends of one dependency, and neither is a substitute for the other.
