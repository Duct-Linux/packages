# libxml2 -- underneath most of the desktop: wayland's scanner, libxkbcommon,
# shared-mime-info, appstream and gnome-shell's own settings parsing all read
# XML through it.
#
# 2.13 rather than 2.14: the 2.14 series changed enough of the parser API that
# consumers pinned to the GNOME 48 release set have not all caught up, and a
# distribution-wide XML parser is the wrong place to be first.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://download.gnome.org/sources/libxml2/2.13/libxml2-2.13.8.tar.xz
SRC_SHA256=277294cb33119ab71b2bc81f2f445e9bc9435b893ad15bb2cd2b0e859a0ee84a
SRC_DIR=libxml2-2.13.8

# --without-python: the bindings need a Python development environment Duct does
# not ship, and nothing here imports libxml2 from Python.
# --disable-static because everything links it dynamically; keeping the archive
# only doubles the package.
CONFIGURE_ARGS="--disable-static --without-python --with-history=no"
