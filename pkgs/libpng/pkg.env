# libpng -- every icon and every cursor in the theme is a PNG, and gdk-pixbuf
# decodes them through this.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://downloads.sourceforge.net/libpng/libpng-1.6.47.tar.xz
SRC_SHA256=b213cb381fbb1175327bd708a77aab708a05adde7b471bc267bd15ac99893631
SRC_DIR=libpng-1.6.47

CONFIGURE_ARGS="--disable-static"
