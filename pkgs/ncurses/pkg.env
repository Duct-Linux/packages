# ncurses -- generated by tools/gen-recipes.sh, safe to edit.
# Source pins come from ../versions.env so a bump is one file.

SRC_URL=$NCURSES_URL
SRC_SHA256=$NCURSES_SHA256
SRC_DIR=$NCURSES_SRCDIR

CONFIGURE_ARGS="--disable-nls --with-shared --without-normal --without-debug --without-ada --enable-widec --enable-pc-files --without-cxx-binding --with-manpage-format=normal --disable-stripping"

# The C++ binding is dropped, not merely unshared. ncurses defines bool as a
# macro expanding to NCURSES_BOOL (unsigned char); once gcc 15's <type_traits>
# is pulled in behind that, std::__is_integral_helper<unsigned char> is defined
# twice and the build dies. Nothing in Duct links libncurses++, so the binding
# is not worth carrying a patch for.
