# lcms2 -- the colour management engine. mutter links it to apply per-monitor
# colour profiles, and colord uses it to build and inspect ICC profiles, so it
# sits underneath both halves of the colour story rather than beside them.
#
# Upstream's version string is "2.17" with two components. package.version must
# parse as semver or the resolver skips the package silently, so it is recorded
# here as 2.17.0 while the tarball keeps its own name.
#
# Not an LFS package, so it is pinned here rather than in versions.env --
# tools/pin-versions.sh regenerates that file wholesale from the LFS book and
# would destroy a desktop pin on the next `make pin`.
SRC_URL=https://github.com/mm2/Little-CMS/releases/download/lcms2.17/lcms2-2.17.tar.gz
SRC_SHA256=d11af569e42a1baa1650d20ad61d12e41af4fead4aa7964a01f93b08b53ab074
SRC_DIR=lcms2-2.17

# The jpeg and tiff plugins build the tificc/jpgicc converters. Both libraries
# are already in the tree, and configure silently drops the converters when they
# are absent -- which is exactly the shape of failure the install assertion
# below exists to catch.
CONFIGURE_ARGS="--disable-static --with-jpeg --with-tiff"
