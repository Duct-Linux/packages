# ca-certificates -- the trust store every TLS client in Duct needs.
#
# Without it nothing in Duct can make an HTTPS request: Go's crypto/x509 finds
# no trust store and fails every handshake with "certificate signed by unknown
# authority", which is how this package came to exist -- tape could not reach
# its own repository from duct/base.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
#
# The dated URL, not the rolling https://curl.se/ca/cacert.pem: that one's
# contents change whenever Mozilla updates its root store, which would make the
# same package version mean different bytes over time. This digest also matches
# the sha256 curl.se publishes alongside the bundle.
SRC_URL=https://curl.se/ca/cacert-2026-07-16.pem
SRC_SHA256=3ff344e30b9b1ed2971044eabb438a08f2e2245ddb5f8ab1a3ad8b63ab4eaf91
SRC_FILE=cacert-2026-07-16.pem

# PEM text, identical everywhere.
PKG_ARCH=any

# SRC_DIR is deliberately unset. The shared install.sh runs `make install` when
# it is set, and there is nothing here to make.
