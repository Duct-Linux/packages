# glibc -- the C library everything else links against.
SRC_URL=$GLIBC_URL
SRC_SHA256=$GLIBC_SHA256
SRC_DIR=$GLIBC_SRCDIR

# The FHS patch is an additional pinned input, fetched onto the build machine by
# tools/fetch-source.sh alongside the tarball and applied by prepare.sh.
#
# Deliberately NOT named PATCH_URL: versions.env already defines that for the
# GNU patch package, so a recipe variable by that name is a shadow that only
# holds while this pkg.env is the one being sourced. Anything generic reading
# PATCH_URL would silently get patch-2.8.tar.xz instead.
EXTRA_URL=$PATCH_GLIBC_FHS_URL
EXTRA_SHA256=$PATCH_GLIBC_FHS_SHA256
