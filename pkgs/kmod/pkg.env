# kmod -- libkmod, which udev calls to load the driver for a device it has just
# discovered. Without it a boot enumerates the hardware and then loads nothing
# for it, which on a live ISO means no graphics and no input.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://www.kernel.org/pub/linux/utils/kernel/kmod/kmod-34.tar.xz
SRC_SHA256=12e7884484151fbd432b6a520170ea185c159f4393c7a2c2a886ab820313149a
SRC_DIR=kmod-34

# 34 is meson-only. The tarball still carries a configure script, but not the
# autotools auxiliary files it needs, so the autotools path fails with "cannot
# find required auxiliary files" rather than with anything that says "use meson".
#
# manpages and docs are off: they are rendered from docbook through xsltproc and
# the stylesheets are not packaged.
#
# zstd and openssl are off because neither is packaged at this point in the
# order. Compressed modules are therefore xz or gzip, which is what the kernel
# package is expected to produce, and module signatures are not verified.
MESON_ARGS="-Dzstd=disabled -Dopenssl=disabled -Dxz=enabled -Dzlib=enabled \
-Dmanpages=false -Ddocs=false -Dbuild-tests=false \
-Dmoduledir=/usr/lib/modules -Ddistconfdir=/usr/lib"
