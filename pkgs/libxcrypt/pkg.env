# libxcrypt -- crypt(3), which glibc no longer provides.
#
# Duct's glibc is configured without --enable-crypt, so there is no libcrypt in
# the base system at all: nothing that hashes a password links today. PAM and
# shadow both do, and both fail to configure without this.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/besser82/libxcrypt/releases/download/v4.4.38/libxcrypt-4.4.38.tar.xz
SRC_SHA256=80304b9c306ea799327f01d9a7549bdb28317789182631f1b54f4511b4206dd6
SRC_DIR=libxcrypt-4.4.38

# --enable-obsolete-api=no: the compatibility ABI exists to replace a glibc
# libcrypt that was already installed. There has never been one here, so there
# is nothing to stay compatible with, and shipping it would mean shipping
# DES-based hashes nothing should still be producing.
#
# --enable-hashes=strong,glibc keeps yescrypt and the SHA-2 hashes shadow and
# PAM actually write, and drops the rest.
CONFIGURE_ARGS="--enable-hashes=strong,glibc --enable-obsolete-api=no --disable-static --disable-failure-tokens"
