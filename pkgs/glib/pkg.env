# glib -- the object system, main loop, D-Bus client and file abstraction the
# whole of GNOME is written against. Everything from here up depends on it.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://download.gnome.org/sources/glib/2.84/glib-2.84.1.tar.xz
SRC_SHA256=2b4bc2ec49611a5fc35f86aca855f2ed0196e69e53092bab6bb73396bf30789a
SRC_DIR=glib-2.84.1

# The introspection option is decided by build.sh rather than set here, because
# it depends on what is installed at the time -- see the comment there.
