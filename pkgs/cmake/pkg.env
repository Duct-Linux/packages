# cmake -- needed to build LLVM, which is needed to build rustc.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/Kitware/CMake/releases/download/v4.4.2/cmake-4.4.2.tar.gz
SRC_SHA256=1db9e61e60b6e0874c86386340b910382f3c5e75b9fbfb44d122063129a2789d
SRC_DIR=cmake-4.4.2

# The shared install.sh runs `make install` from $BUILD_DIR; cmake's bootstrap
# configures in-tree, so the build directory is the source directory.
