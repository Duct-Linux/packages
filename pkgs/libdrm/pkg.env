# libdrm -- the ioctl wrapper every GPU driver in mesa goes through, and what
# mutter uses to set a mode and page-flip on the display.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://dri.freedesktop.org/libdrm/libdrm-2.4.124.tar.xz
SRC_SHA256=ac36293f61ca4aafaf4b16a2a7afff312aa4f5c37c9fbd797de9e3c0863ca379
SRC_DIR=libdrm-2.4.124

# The per-vendor helper libraries are left on auto: which ones are buildable is
# a property of the architecture, and naming them here would mean maintaining
# two lists that have to agree with meson's own idea of what applies.
MESON_ARGS="-Dudev=true -Dvalgrind=disabled -Dtests=false -Dcairo-tests=disabled \
-Dman-pages=disabled -Dinstall-test-programs=false"
