# gobject-introspection -- the machinery that lets a language that is not C call
# a GObject library without anyone hand-writing bindings.
#
# This is why gnome-shell can be written in JavaScript: gjs reads the typelibs
# produced here and calls straight into Clutter, Mutter and Gio. Without it
# there is no shell, only libraries.
#
# Built between glib's two passes -- see glib/build.sh.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://download.gnome.org/sources/gobject-introspection/1.84/gobject-introspection-1.84.0.tar.xz
SRC_SHA256=945b57da7ec262e5c266b89e091d14be800cc424277d82a02872b7d794a84779
SRC_DIR=gobject-introspection-1.84.0

MESON_ARGS="-Dbuild_introspection_data=true -Ddoctool=disabled -Dgtk_doc=false -Dtests=false"
