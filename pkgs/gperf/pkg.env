# gperf -- generates the perfect hash tables that fontconfig, mesa, eudev and
# several GNOME components keep in their source trees as build products rather
# than checked-in files.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://ftpmirror.gnu.org/gperf/gperf-3.3.tar.gz
SRC_SHA256=fd87e0aba7e43ae054837afd6cd4db03a3f2693deb3619085e6ed9d8d9604ad8
SRC_DIR=gperf-3.3

CONFIGURE_ARGS="--docdir=/usr/share/doc/gperf-3.3"
