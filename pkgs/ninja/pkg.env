# ninja -- LLVM builds an order of magnitude faster with it than with make,
# which matters when LLVM is a dependency of rustc.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/ninja-build/ninja/archive/refs/tags/v1.13.2.tar.gz
SRC_SHA256=974d6b2f4eeefa25625d34da3cb36bdcebe7fbce40f4c16ac0835fd1c0cbae17
SRC_DIR=ninja-1.13.2

# A GitHub archive URL ends in the bare tag, so without this the tarball caches
# as "v1.13.2.tar.gz" and collides with every other project tagged the same.
SRC_FILE=ninja-1.13.2.tar.gz
