# go -- the toolchain tape itself is written in.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
#
# Building Go needs Go: there has been no C bootstrap path since 1.20, so
# duct/go supplies a pinned upstream release as GOROOT_BOOTSTRAP and everything
# in the package is compiled by it from source.
SRC_URL=https://go.dev/dl/go1.26.5.src.tar.gz
SRC_SHA256=495be4bc87176ac567392e5b4116abd98466d33d7b49d41e764ccc6976b2dc42
SRC_DIR=go
SRC_FILE=go1.26.5.src.tar.gz

# Not in any Makefile build list, deliberately.
PKG_UNLISTED=built in duct/go, which the local Makefile has no target for -- building Go needs Go, so it bootstraps from a pinned upstream release in its own image. CI builds it from the per-directory matrix.
