# python-jinja2 -- a build-time dependency of elogind, whose meson build renders
# several generated sources through tools/meson-render-jinja2.py. It is not
# optional there: the templates cover src/login, src/libelogind and the udev
# rules, not just the man pages that could be switched off.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://files.pythonhosted.org/packages/source/J/Jinja2/jinja2-3.1.6.tar.gz
SRC_SHA256=0137fb05990d35f1275a587e9aee6d56da821fc83491a0fb838183be43f66d6d
SRC_DIR=jinja2-3.1.6

PKG_ARCH=any
