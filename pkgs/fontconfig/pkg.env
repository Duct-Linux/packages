# fontconfig -- answers "which file holds a glyph for this character in this
# family at this weight". Pango asks it for every run of text it shapes.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://www.freedesktop.org/software/fontconfig/release/fontconfig-2.16.0.tar.xz
SRC_SHA256=6a33dc555cc9ba8b10caf7695878ef134eeb36d0af366041f639b1da9b6ed220
SRC_DIR=fontconfig-2.16.0

# cache-build=disabled: the build would otherwise scan the *build machine's*
# fonts and ship the resulting cache, which describes nothing on the installed
# system. The cache is generated there instead -- see post-install.sh.
MESON_ARGS="-Ddoc=disabled -Dtests=disabled -Dcache-build=disabled -Dnls=disabled"
