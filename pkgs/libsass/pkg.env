# libsass -- the Sass compiler behind sassc, which gtk4 and libadwaita both
# compile their stylesheets with.
#
# Not optional and not obvious. libadwaita's src/stylesheet/meson.build looks
# for sassc and, when it is missing, falls back to
# subproject('sassc') -- a wrap that would be downloaded at build time. Duct's
# meson stage is run with --wrap-mode=nodownload precisely so that cannot
# happen, so the fallback is a hard failure rather than a silent vendored copy.
# The stylesheet is generated from .scss on every build; there is no
# pre-generated CSS to fall back on.
#
# Built from its plain Makefile rather than autotools: the release tarball has
# no configure, and generating one would need autoconf, automake and libtool,
# none of which are packaged.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/sass/libsass/archive/3.6.6/libsass-3.6.6.tar.gz
SRC_SHA256=11f0bb3709a4f20285507419d7618f3877a425c0131ea8df40fe6196129df15d
SRC_DIR=libsass-3.6.6

# A GitHub archive URL ends in the bare tag.
SRC_FILE=libsass-3.6.6.tar.gz
