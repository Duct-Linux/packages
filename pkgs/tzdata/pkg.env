# tzdata -- the time zone database, and there was none in this tree at all.
#
# FOUND BY LOOKING FOR IT RATHER THAN BY A FAILURE: libgweather has a
# `zoneinfo_dir` option defaulting to /usr/share/zoneinfo, which sent me to
# check whether that path exists here. It does not, no package ships it, and
# gate-check reports tzdata ABSENT. libgweather itself turned out not to care --
# it sets ZONEINFO_DIR in config.h and nothing in 4.4.4 reads the macro -- but a
# desktop with no timezone database is green-and-wrong on its face: glibc's
# localtime(3) reads /usr/share/zoneinfo directly, so without this every process
# on the system believes it is UTC.
#
# LFS 12.4 installs this inside the glibc chapter (8.5.2.2) rather than as a
# package of its own, which is why it has no entry in tools/pin-versions.sh's
# PACKAGES array and is pinned here -- the readline precedent.
SRC_URL=https://www.iana.org/time-zones/repository/releases/tzdata2025b.tar.gz
SRC_SHA256=11810413345fc7805017e27ea9fa4885fd74cd61b2911711ad038f5d28d71474
SRC_DIR=tzdata-2025b

# ARCHITECTURE-INDEPENDENT, AND THIS NEEDS A REASON RATHER THAN AN ASSUMPTION.
# zic emits TZif files, whose format is fixed big-endian by RFC 8536 -- the
# output does not depend on the host that produced it. That is why Debian ships
# tzdata as Architecture: all and Fedora as noarch. Stated because `any` means
# ONE build serves both architectures, so if it were false the error would be
# silent and only on the arch that did not build it.
PKG_ARCH=any

# There is no configure and no compiler: the whole build is zic, which comes
# from glibc. See build.sh.
