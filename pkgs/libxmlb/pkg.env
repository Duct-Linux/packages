# libxmlb -- appstream's storage format: a memory-mappable binary form of the
# metadata XML, so querying it does not mean parsing megabytes on every start.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/hughsie/libxmlb/releases/download/0.3.22/libxmlb-0.3.22.tar.xz
SRC_SHA256=f3c46e85588145a1a86731c77824ec343444265a457647189a43b71941b20fa0
SRC_DIR=libxmlb-0.3.22

MESON_ARGS="-Dgtkdoc=false -Dintrospection=false -Dtests=false -Dstemmer=false"
