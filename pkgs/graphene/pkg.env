# graphene -- the vector, matrix and quaternion types GTK 4's scene graph is
# built on. A hard dependency of gtk4, not an optimisation.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://download.gnome.org/sources/graphene/1.10/graphene-1.10.8.tar.xz
SRC_SHA256=a37bb0e78a419dcbeaa9c7027bcff52f5ec2367c25ec859da31dfde2928f279a
SRC_DIR=graphene-1.10.8

MESON_ARGS="-Dintrospection=enabled -Dgtk_doc=false -Dtests=false -Dinstalled_tests=false"
