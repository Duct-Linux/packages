# libusb -- userspace access to USB devices.
#
# Packaged for exactly one consumer: libgusb, which colord requires
# unconditionally (colord-1.4.8/meson.build line 120, no required:false and not
# inside any conditional). colord in turn is what lets mutter apply per-monitor
# colour profiles, so the whole short chain hangs off the colour story.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/libusb/libusb/releases/download/v1.0.29/libusb-1.0.29.tar.bz2
SRC_SHA256=5977fc950f8d1395ccea9bd48c06b3f808fd3c2c961b44b0c2e6e29fc3a70a85
SRC_DIR=libusb-1.0.29

# udev is enabled by default and is NOT optional once enabled: configure.ac
# lines 207-210 hard-error with "udev support requested but libudev not
# installed" rather than falling back. eudev provides libudev here, and it is
# declared as a runtime dependency because the built library carries a
# DT_NEEDED on libudev.so.
#
# Left enabled deliberately: without udev, libusb falls back to polling
# /dev/bus/usb and loses hotplug entirely, which is the half colord's sensor
# support actually uses.
CONFIGURE_ARGS="--disable-static --enable-udev"
