# libxkbcommon -- compiles a keymap from xkeyboard-config's rules and turns
# keycodes into keysyms.
#
# In an X session the server did this; under Wayland there is no server to do
# it, so mutter compiles the keymap here and hands the result to each client
# over the protocol. GTK then interprets it with this same library.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/xkbcommon/libxkbcommon/archive/xkbcommon-1.8.1/libxkbcommon-1.8.1.tar.gz
SRC_SHA256=c65c668810db305c4454ba26a10b6d84a96b5469719fe3c729e1c6542b8d0d87
SRC_DIR=libxkbcommon-xkbcommon-1.8.1

# A GitHub archive URL ends in the bare tag; the directory inside is the
# repository name joined to it, which is why SRC_DIR reads the way it does.
SRC_FILE=libxkbcommon-1.8.1.tar.gz

# xkbregistry is kept: gnome-control-center and gdm both read the layout list
# through it rather than parsing xkeyboard-config's XML themselves.
#
# enable-wayland builds a demonstration client, not the Wayland support -- that
# is in the core library either way.
MESON_ARGS="-Denable-docs=false -Denable-wayland=false -Denable-xkbregistry=true \
-Dxkb-config-root=/usr/share/X11/xkb"
