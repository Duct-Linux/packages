# libvorbis -- the Vorbis audio codec, and the reason it is here is a hard
# requirement rather than a preference.
#
# libcanberra's configure.ac:584 is literally
#
#     ### Vorbis (mandatory) ###
#     PKG_CHECK_MODULES(VORBIS, [ vorbisfile ])
#
# unguarded by any --enable/--disable. So there is no libcanberra without this,
# and no desktop event sounds without libcanberra. It is also what actually
# decodes the .oga files in the freedesktop sound theme.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://downloads.xiph.org/releases/vorbis/libvorbis-1.3.7.tar.xz
SRC_SHA256=b33cc4934322bcbf6efcbacf49e3ca01aadbea4114ec9589d1b1e9d20f72954b
SRC_DIR=libvorbis-1.3.7

CONFIGURE_ARGS="--disable-static"
