# xcb-util -- utility functions over libxcb, packaged for startup-notification.
#
# WHICH xcb-util THIS IS MATTERS. Upstream split these utilities into five
# separate packages -- xcb-util, xcb-util-image, xcb-util-keysyms,
# xcb-util-renderutil and xcb-util-wm -- and only this base one carries what
# startup-notification asks for. Its configure.in does
#
#     PKG_CHECK_MODULES([xcb_aux],   [xcb-aux])
#     PKG_CHECK_MODULES([xcb_event], [xcb-event])
#
# both hard, and this tarball is what provides xcb-aux.pc and xcb-event.pc --
# verified from the tarball's own file list, because BLFS's page names only
# "Installed Library: libxcb-util.so" and never mentions the .pc files at all.
# Reading the page alone would leave that unverified.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://xcb.freedesktop.org/dist/xcb-util-0.4.1.tar.xz
SRC_SHA256=5abe3bbbd8e54f0fa3ec945291b7e8fa8cfd3cccc43718f8758430f94126e512
SRC_DIR=xcb-util-0.4.1

CONFIGURE_ARGS="--disable-static"
