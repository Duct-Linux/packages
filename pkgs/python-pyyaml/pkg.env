# python-pyyaml -- a build-time dependency of mesa, which stops at configure
# with "Python (3.x) yaml module (PyYAML) required to build mesa".
#
# The third package in this set needed only because Duct's python is built
# --without-ensurepip and therefore ships no third-party modules whatsoever.
# The other two were setuptools and mako.
#
# Worth noting how this one was found, because it defeated the check written
# for exactly this class: mesa does not ask meson's find_installation for the
# module, it runs a run_command() that imports it. The declarative form is
# checkable and the imperative one is not, so check-recipes.sh now greps for
# both -- see the comment there.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/yaml/pyyaml/archive/6.0.2/pyyaml-6.0.2.tar.gz
SRC_SHA256=9377c381ac3fccad8df73d96b5139ef8b1a2c57a0d913e95ab0a2275d66b5caa
SRC_DIR=pyyaml-6.0.2

# A GitHub archive URL ends in the bare tag.
SRC_FILE=pyyaml-6.0.2.tar.gz

# The libyaml-backed C extension is not built (see install.sh), so what ships is
# pure Python and identical everywhere.
PKG_ARCH=any
