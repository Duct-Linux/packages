# harfbuzz -- turns a string and a font into positioned glyphs: ligatures,
# kerning, Indic reordering, Arabic joining. Pango does the line breaking and
# harfbuzz does the shaping.
#
# Built after glib rather than beside freetype, because pango needs a harfbuzz
# that knows about GLib's Unicode tables and harfbuzz only builds that if glib
# is present when it configures.
#
# graphite2 is not packaged, so SIL's Graphite fonts shape through the OpenType
# path instead. icu is not packaged either; harfbuzz uses GLib's Unicode
# functions, which is the configuration GNOME ships.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/harfbuzz/harfbuzz/releases/download/11.0.0/harfbuzz-11.0.0.tar.xz
SRC_SHA256=f16351bafe214725fe2c1d5b59f0d93e49905a4b247899fb90d70cff953a2b9b
SRC_DIR=harfbuzz-11.0.0

MESON_ARGS="-Dglib=enabled -Dfreetype=enabled -Dcairo=disabled -Dicu=disabled \
-Dgraphite2=disabled -Dintrospection=enabled -Ddocs=disabled -Dtests=disabled -Dutilities=disabled"
