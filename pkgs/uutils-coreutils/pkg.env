# uutils-coreutils -- the one package written in a language Duct does not
# package. It is built in duct/rust rather than duct/chroot, cross-linked
# against Duct's glibc with the cross gcc. See docker/Dockerfile.rust.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/uutils/coreutils/archive/refs/tags/0.10.0.tar.gz
SRC_SHA256=f8e68cd0e3629378f047544ead272161a83211c43f4985a9f52944e5db8f1a44
SRC_DIR=coreutils-0.10.0

# GitHub archive URLs end in the bare tag, so without this the tarball would be
# cached as "0.10.0.tar.gz".
SRC_FILE=uutils-coreutils-0.10.0.tar.gz
