# libnotify -- sends desktop notifications over D-Bus, and ships notify-send.
#
# gnome-settings-daemon and a long tail of GNOME components use it to raise
# notifications that gnome-shell then draws, so it is needed well before the
# shell itself.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://download.gnome.org/sources/libnotify/0.8/libnotify-0.8.6.tar.xz
SRC_SHA256=c5540aaefb60e1d63b1c587c05f2284ebe72ece7d0c0e5e4a778cfd5844b6b58
SRC_DIR=libnotify-0.8.6

# -Dtests=false IS LOAD-BEARING AND MUST NOT BE DROPPED. It defaults to true
# upstream, and meson.build line 47 reads:
#
#   gtk_dep = dependency('gtk+-3.0', version: '>= 2.90', required: get_option('tests'))
#
# so leaving tests on makes GTK 3 a HARD requirement of libnotify. This tree is
# Wayland-first and had no GTK 3 at all when this recipe was written; turning
# the tests on would pull an entire second toolkit in behind a package whose own
# description mentions no toolkit. The dependency is invisible from the
# dependency list and visible only in that one line.
#
# -Dgtk_doc=false needs gi-docgen, which is not packaged. -Ddocbook_docs
# defaults to 'auto' and would try xmlto, also not packaged, so it is pinned off
# rather than left to whatever the image happens to contain.
#
# -Dman=false. UPSTREAM DEFAULT IS TRUE, and having xsltproc is NOT ENOUGH to
# satisfy it -- this recipe first shipped -Dman=true on exactly that reasoning
# and CI rejected it on both architectures. meson.build 58-77 does two separate
# things under this option:
#
#   xsltproc   = find_program('xsltproc', required: true)
#   stylesheet = 'http://docbook.sourceforge.net/release/xsl-ns/current/manpages/docbook.xsl'
#   testrun    = run_command(xsltproc, '--nonet', stylesheet, check: false)
#   if testrun.returncode() != 0
#     error('DocBook stylesheet for generating man pages not found, ...')
#
# The tool is found; the *stylesheet* is not. It is named by URL and fetched
# with --nonet, so it resolves only out of a local docbook-xsl-ns install
# registered in an XML catalog -- a separate package from libxslt, and one this
# tree does not have. The probe is a hard error(), not a fallback, so the whole
# configure step dies over one man page for notify-send.
#
# This is the same call kmod, eudev, elogind, ostree, linux-pam, wayland, dconf
# and flatpak each already made, and the reason appstream patches its man pages
# out in prepare.sh: no DocBook stylesheets are packaged anywhere in this tree.
# libxslt is no longer declared in [dependencies.build] because turning this off
# leaves nothing in libnotify that invokes xsltproc -- both call sites
# (meson.build:59 and docs/meson.build:36) sit inside `if get_option('man')`.
MESON_ARGS="-Dtests=false -Dgtk_doc=false -Ddocbook_docs=disabled -Dman=false -Dintrospection=enabled"
