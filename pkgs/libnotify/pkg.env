# libnotify -- sends desktop notifications over D-Bus, and ships notify-send.
#
# gnome-settings-daemon and a long tail of GNOME components use it to raise
# notifications that gnome-shell then draws, so it is needed well before the
# shell itself.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://download.gnome.org/sources/libnotify/0.8/libnotify-0.8.6.tar.xz
SRC_SHA256=c5540aaefb60e1d63b1c587c05f2284ebe72ece7d0c0e5e4a778cfd5844b6b58
SRC_DIR=libnotify-0.8.6

# -Dtests=false IS LOAD-BEARING AND MUST NOT BE DROPPED. It defaults to true
# upstream, and meson.build line 47 reads:
#
#   gtk_dep = dependency('gtk+-3.0', version: '>= 2.90', required: get_option('tests'))
#
# so leaving tests on makes GTK 3 a HARD requirement of libnotify. This tree is
# Wayland-first and had no GTK 3 at all when this recipe was written; turning
# the tests on would pull an entire second toolkit in behind a package whose own
# description mentions no toolkit. The dependency is invisible from the
# dependency list and visible only in that one line.
#
# -Dgtk_doc=false needs gi-docgen, which is not packaged. -Ddocbook_docs
# defaults to 'auto' and would try xmlto, also not packaged, so it is pinned off
# rather than left to whatever the image happens to contain. -Dman=true is kept:
# it needs xsltproc, which libxslt provides and which is declared above.
MESON_ARGS="-Dtests=false -Dgtk_doc=false -Ddocbook_docs=disabled -Dman=true -Dintrospection=enabled"
