# Mozilla publishes native, signed release builds for both Duct architectures.
# ESR is intentional: it gives the live image security updates without changing
# browser ABI and policy every four weeks.
case ${TARGET:-$(uname -m)} in
	x86_64*)
		SRC_URL=https://archive.mozilla.org/pub/firefox/releases/140.13.0esr/linux-x86_64/en-US/firefox-140.13.0esr.tar.xz
		SRC_SHA256=866d7e5f94abe93132e02a0db72da32b6e133905fcbea6afa417a96d496021da
		SRC_FILE=firefox-140.13.0esr-linux-x86_64.tar.xz
		;;
	aarch64*|arm64*)
		SRC_URL=https://archive.mozilla.org/pub/firefox/releases/140.13.0esr/linux-aarch64/en-US/firefox-140.13.0esr.tar.xz
		SRC_SHA256=2ffa18ecaa4caf2e1e43d40861a66a479bbe8cda87da7e87861aed89a032bb7f
		SRC_FILE=firefox-140.13.0esr-linux-aarch64.tar.xz
		;;
	*) echo "firefox: unsupported target ${TARGET:-$(uname -m)}" >&2; return 1 2>/dev/null || exit 1 ;;
esac
SRC_DIR=firefox

