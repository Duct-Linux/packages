# pcre2 -- GLib's regular expressions are pcre2 underneath, so this sits below
# every GNOME component rather than beside them.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.45/pcre2-10.45.tar.bz2
SRC_SHA256=21547f3516120c75597e5b30a992e27a592a31950b5140e7b8bfde3f192033c4
SRC_DIR=pcre2-10.45

# Unicode is not optional: GLib requires a pcre2 built with it, and fails at
# configure time rather than at runtime if it is missing.
CONFIGURE_ARGS="--enable-unicode --enable-jit --enable-pcre2-16 --enable-pcre2-32 --disable-static --docdir=/usr/share/doc/pcre2-10.45"
