# tape is cross-built by the Go toolchain in duct/bootstrap, not compiled here.
# There is no Go compiler in the Duct package set yet, so this package copies
# the binaries the bootstrap image already carries rather than building them.
#
# This is one of the two islands that cannot self-host (the other is
# uutils-coreutils, which needs Rust). Packaging Go is a project of its own.

# Where to take the binaries from. The bootstrap image installs them here.
TAPE_BIN_DIR=${TAPE_BIN_DIR:-/usr/bin}

# tape's own binaries are static, so the package is architecture-specific only
# because the ELF is. Stamped from --target like everything else.
