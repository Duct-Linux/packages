# gnome-backgrounds -- the default wallpapers, and the XML that tells the
# desktop they exist.
#
# gsettings-desktop-schemas ships a default picture-uri pointing into
# /usr/share/backgrounds/gnome, so without this package a fresh session comes up
# with a broken wallpaper reference rather than a blank one.
#
# Images and XML only -- no compiled code -- so it is built once and installed
# everywhere. PKG_ARCH is read from this file by CI's select job and by the
# Makefile; declaring it in only one of the two places is what made two earlier
# packages disagree with themselves, so it lives here and nowhere else.
PKG_ARCH=any

# KNOWN GAP, RECORDED RATHER THAN HIDDEN: the wallpapers in 48.2.1 are JPEG XL
# (.jxl), and nothing in this tree can decode them yet. BLFS 12.4 lists
# libjxl-0.11.1 as "Required at runtime" for exactly this reason -- the JXL
# gdk-pixbuf loader ships with libjxl, not with gdk-pixbuf, and this tree's
# gdk-pixbuf is built with -Dothers=enabled, which does not include it.
#
# So this package installs correctly and its images are verifiably present, and
# the desktop will still show no wallpaper until libjxl (and highway, which it
# needs) are packaged. That is a missing decoder, not a broken install, which is
# why it is a comment here rather than a [dependencies] entry -- declaring a
# package that does not exist would make this recipe unresolvable.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://download.gnome.org/sources/gnome-backgrounds/48/gnome-backgrounds-48.2.1.tar.xz
SRC_SHA256=6a1c5b7b2e0d8f5ce977926d55f9c2d65dd180822cdea5e59150dcfb5abd1ed9
SRC_DIR=gnome-backgrounds-48.2.1
