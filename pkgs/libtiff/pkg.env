# libtiff -- a gdk-pixbuf loader. Little on a desktop is a TIFF, but the loader
# set is what makes GdkPixbuf's format list honest, and scanners produce them.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://download.osgeo.org/libtiff/tiff-4.7.0.tar.gz
SRC_SHA256=67160e3457365ab96c5b3286a0903aa6e78bdc44c4bc737d2e486bcecb6ba976
SRC_DIR=tiff-4.7.0

CONFIGURE_ARGS="--disable-static --disable-webp --disable-zstd --disable-lerc"
