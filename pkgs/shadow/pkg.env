# shadow -- useradd, passwd, login and /etc/shadow itself.
#
# The desktop needs it twice over: gdm authenticates against the shadow file
# through PAM, and the service accounts dbus, polkit and gdm run as have to be
# creatable at all.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/shadow-maint/shadow/releases/download/4.17.4/shadow-4.17.4.tar.xz
SRC_SHA256=554801054694ff7d8a7abdf0d6ece34e2f16e111673cc01b8c9ee1278451181e
SRC_DIR=shadow-4.17.4

# --with-libpam so login and passwd go through the stack Linux-PAM installed
# rather than reading /etc/shadow directly; without it gdm and shadow would
# disagree about how a password is checked.
#
# --without-libbsd: not packaged, and only used for readpassphrase, which shadow
# has its own implementation of.
CONFIGURE_ARGS="--sysconfdir=/etc --disable-static --with-libpam --without-libbsd \
--with-group-name-max-length=32 --disable-nls --docdir=/usr/share/doc/shadow-4.17.4"
