# bc -- a calculator nobody would package for its own sake.
#
# The kernel build needs it: kernel/time/Makefile generates timeconst.h by
# piping a script through bc, and there is no fallback path. Without bc the
# linux package fails several thousand objects into the build, which is a long
# way to travel for a missing 100 KB program.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://ftp.gnu.org/gnu/bc/bc-1.08.2.tar.gz
SRC_SHA256=ae470fec429775653e042015edc928d07c8c3b2fc59765172a330d3d87785f86
SRC_DIR=bc-1.08.2

# No --disable-nls: bc has no gettext support at all, so the flag other recipes
# pass uniformly would only earn an "unrecognized option" warning here.
#
# readline and libedit are both off by default; naming them anyway keeps the
# package from silently growing a dependency on whichever one happens to be
# installed in the build image on some later day.
CONFIGURE_ARGS="--without-readline --without-libedit"
