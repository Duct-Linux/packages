# mtdev -- translates the kernel's older multitouch protocol into the slotted
# one libinput expects. Touchpads on hardware that predates protocol B send the
# old form, and without this they arrive as a single confused pointer.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://bitmath.org/code/mtdev/mtdev-1.1.7.tar.bz2
SRC_SHA256=a107adad2101fecac54ac7f9f0e0a0dd155d954193da55c2340c97f2ff1d814e
SRC_DIR=mtdev-1.1.7

CONFIGURE_ARGS="--disable-static"
