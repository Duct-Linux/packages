# xdg-user-dirs -- creates ~/Desktop, ~/Downloads and the rest on first login,
# and writes the user-dirs.dirs file that everything else reads them from.
#
# gnome-session runs xdg-user-dirs-update at session start, and GTK's file
# chooser, nautilus and the screenshot path in gnome-shell all resolve their
# default locations through it. Without it those land in the home directory.
#
# Upstream's version is "0.18"; recorded as 0.18.0 because package.version must
# parse as semver or the resolver skips the package silently.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://user-dirs.freedesktop.org/releases/xdg-user-dirs-0.18.tar.gz
SRC_SHA256=ec6f06d7495cdba37a732039f9b5e1578bcb296576fde0da40edb2f52220df3c
SRC_DIR=xdg-user-dirs-0.18

# --disable-documentation: the man pages are built with xsltproc against the
# DocBook stylesheets, which are not packaged. The tool itself does not need
# them and configure will otherwise stop.
#
# --sysconfdir=/etc is NOT optional, for the reason e2fsprogs already records in
# its own pkg.env: autotools defaults sysconfdir to ${prefix}/etc and does not
# special-case a /usr prefix, so without this flag user-dirs.defaults and
# user-dirs.conf install into /usr/etc/xdg -- where nothing reads them. The
# build succeeds, the package installs, and the tool silently creates no
# directories. meson does not need the flag because it special-cases /usr; this
# is autotools, so it does.
CONFIGURE_ARGS="--disable-documentation --sysconfdir=/etc"
