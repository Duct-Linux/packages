# libgusb -- a GObject wrapper around libusb, with GMainLoop integration.
#
# Packaged because colord requires it unconditionally: colord-1.4.8/meson.build
# line 120 is `gusb = dependency('gusb', version : '>= 0.2.7')` with no
# required:false and no enclosing conditional. colord will not configure
# without it.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/hughsie/libgusb/releases/download/0.4.9/libgusb-0.4.9.tar.xz
SRC_SHA256=9df5ef301d6a4b361002aa52cce1165a87a89744055879bdbab31e7e86f1e846
SRC_DIR=libgusb-0.4.9

# Three of these options default to true upstream and would each pull in a tool
# this tree does not have, so none of them is cosmetic:
#   vapi=false   needs vala, which is not packaged.
#   docs=false   needs gi-docgen, which is not packaged.
#   tests=false  builds the self-test binaries; nothing installs them.
# umockdev is a 'auto' feature and would be picked up if it ever appeared, so it
# is pinned off explicitly rather than left to whatever happens to be installed.
#
# usb_ids is deliberately left at its upstream default of
# /usr/share/hwdata/usb.ids. It is compiled in as a -DUSB_IDS string
# (gusb/meson.build line 3) and read at RUN time, not at build time -- which is
# why hwdata is declared as a runtime dependency rather than a build one. A
# missing file there costs vendor names, not a build.
MESON_ARGS="-Dvapi=false -Ddocs=false -Dtests=false -Dintrospection=true -Dumockdev=disabled"
