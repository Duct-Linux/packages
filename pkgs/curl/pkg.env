# curl -- libcurl, which appstream links to fetch catalogue metadata.
#
# Packaged for that rather than for the command-line tool, though the tool comes
# with it and is worth having on a live ISO.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://curl.se/download/curl-8.13.0.tar.xz
SRC_SHA256=4a093979a3c2d02de2fbc00549a32771007f2e78032c6faa5ecd2f7a9e152025
SRC_DIR=curl-8.13.0

# TLS is back. curl 8.13 could not be built against OpenSSL 4.0 -- 4.0 made the
# ASN1_* string types opaque and curl reaches directly into them, exactly as
# Python's _ssl does. Two independent consumers failing identically is what
# moved the distribution to 3.5 LTS. Recorded rather than erased, because a
# libcurl that cannot fetch https is the kind of gap that should never be
# quietly reintroduced.
#
# --with-ca-bundle points at the store ca-certificates already populates, so a
# fresh curl trusts the same roots tape does rather than nothing at all.
#
# --enable-threaded-resolver: the alternative is a resolver that blocks the
# whole process on DNS, which in a GUI is a frozen window.
CONFIGURE_ARGS="--disable-static --with-openssl \
--with-ca-bundle=/etc/ssl/certs/ca-certificates.crt \
--enable-threaded-resolver --without-libpsl --disable-ldap --disable-ldaps"
