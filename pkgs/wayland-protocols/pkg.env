# wayland-protocols -- the XML for everything the core protocol deliberately
# leaves out: xdg-shell (windows have titles and can be resized), pointer
# constraints, idle inhibit, fractional scaling.
#
# XML and pkg-config files only. Nothing is compiled here; consumers run
# wayland-scanner over these at their own build time.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://gitlab.freedesktop.org/wayland/wayland-protocols/-/releases/1.41/downloads/wayland-protocols-1.41.tar.xz
SRC_SHA256=2786b6b1b79965e313f2c289c12075b9ed700d41844810c51afda10ee329576b
SRC_DIR=wayland-protocols-1.41

MESON_ARGS="-Dtests=false"

PKG_ARCH=any
