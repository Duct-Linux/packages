# acl -- libacl. gio reads and preserves ACLs when copying, and elogind sets one
# on the seat's device nodes so the logged-in user can reach them.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://download.savannah.gnu.org/releases/acl/acl-2.3.2.tar.xz
SRC_SHA256=97203a72cae99ab89a067fe2210c1cbf052bc492b479eca7d226d9830883b0bd
SRC_DIR=acl-2.3.2

CONFIGURE_ARGS="--disable-static --docdir=/usr/share/doc/acl-2.3.2"
