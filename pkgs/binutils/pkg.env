# binutils -- generated by tools/gen-recipes.sh, safe to edit.
# Source pins come from ../versions.env so a bump is one file.

SRC_URL=$BINUTILS_URL
SRC_SHA256=$BINUTILS_SHA256
SRC_DIR=$BINUTILS_SRCDIR

CONFIGURE_ARGS="--disable-nls --enable-gold --enable-ld=default --enable-plugins --enable-64-bit-bfd --enable-new-dtags --enable-default-hash-style=gnu --with-system-zlib --disable-werror --enable-gprofng=no --enable-deterministic-archives"

# --enable-deterministic-archives makes ar zero the timestamp, uid, gid and mode
# in every member header by default.
#
# Without it, ar stamps the build time into each member, so two builds of the
# same source produce different .a files -- identical member lists, identical
# order, identical sizes, different bytes. That was the whole of glibc's
# non-determinism: 7 static archives out of 1463 files, with every shared
# library and binary already identical.
#
# It applies to every package that builds a static archive, not just glibc, and
# takes effect once binutils has been rebuilt with it and lands in the builder
# image.
