# binutils -- generated by tools/gen-recipes.sh, safe to edit.
# Source pins come from ../versions.env so a bump is one file.

SRC_URL=$BINUTILS_URL
SRC_SHA256=$BINUTILS_SHA256
SRC_DIR=$BINUTILS_SRCDIR

CONFIGURE_ARGS="--disable-nls --enable-gold --enable-ld=default --enable-plugins --enable-64-bit-bfd --enable-new-dtags --enable-default-hash-style=gnu --with-system-zlib --disable-werror --enable-gprofng=no"
