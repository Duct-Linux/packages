# libassuan -- the IPC protocol library gpgme uses to drive the gpg process.
#
# This is the component that makes the whole GnuPG chain unavoidable rather than
# merely conventional. flatpak takes dependency('gpgme', '>=1.8.0') with no
# option guard, and gpgme DOES NOT IMPLEMENT CRYPTO: it spawns the gpg binary and
# speaks Assuan to it over a pipe. So gpgme needs this, and it needs gnupg to
# have something to talk to. Flathub's repository signatures are GPG.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://gnupg.org/ftp/gcrypt/libassuan/libassuan-3.0.2.tar.bz2
SRC_SHA256=d2931cdad266e633510f9970e1a2f346055e351bb19f9b78912475b8074c36f6
SRC_DIR=libassuan-3.0.2

# --disable-doc. configure builds the documentation by default. texinfo IS
# packaged, so this would succeed -- it is off to save the time rather than
# because it would fail. Distinguishing "would not work" from "not worth doing"
# matters because only one of them changes if a dependency lands later.
#
# --disable-static RESTATES A DEFAULT HERE AND IS KEPT ANYWAY, said plainly
# rather than left looking load-bearing. configure reports
# "--enable-static[=PKGS] build static libraries [default=no]", so libtool
# already builds shared only. It is passed for consistency with every other
# library recipe in this tree, and because the default belongs to libtool rather
# than to this package.
CONFIGURE_ARGS="--disable-static --disable-doc"
