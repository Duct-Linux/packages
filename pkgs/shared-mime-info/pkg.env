# shared-mime-info -- the rules that decide a file's type from its name and its
# first few bytes. gdk-pixbuf picks a loader with it and nautilus picks an icon
# and a default application with it.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://gitlab.freedesktop.org/xdg/shared-mime-info/-/archive/2.4/shared-mime-info-2.4.tar.bz2
SRC_SHA256=32dc32ae39ff1c1bf8434dd3b36770b48538a1772bc0298509d034f057005992
SRC_DIR=shared-mime-info-2.4

# A GitLab archive URL ends in the bare tag.
SRC_FILE=shared-mime-info-2.4.tar.bz2

# update-mimedb=false: the compiled mime.cache is a build product of every
# package's MIME definitions taken together, so it cannot belong to this one.
# The image build runs update-mime-database, in the same place it runs ldconfig.
MESON_ARGS="-Dupdate-mimedb=false -Dbuild-tests=false"
