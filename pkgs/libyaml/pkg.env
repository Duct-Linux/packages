# libyaml -- appstream reads Debian-style DEP-11 catalogue metadata, which is
# YAML. Nothing else here wants it.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/yaml/libyaml/releases/download/0.2.5/yaml-0.2.5.tar.gz
SRC_SHA256=c642ae9b75fee120b2d96c712538bd2cf283228d2337df2cf2988e3c02678ef4
SRC_DIR=yaml-0.2.5

CONFIGURE_ARGS="--disable-static"
