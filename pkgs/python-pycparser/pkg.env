# python-pycparser -- mesa parses kernel headers with it while generating the
# etnaviv driver's hardware database, and stops at configure without it:
# "Python (3.x) pycparser module >= 2.20 required to build mesa".
#
# The fourth package existing only because Duct's python is built
# --without-ensurepip, after setuptools, mako and pyyaml. Each was found by a
# build stopping rather than by anything declaring it, which is the argument
# for the module check in tools/check-recipes.sh.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://files.pythonhosted.org/packages/source/p/pycparser/pycparser-2.22.tar.gz
SRC_SHA256=491c8be9c040f5390f5bf44a5b07752bd07f56edf992381b05c701439eec10f6
SRC_DIR=pycparser-2.22

PKG_ARCH=any
