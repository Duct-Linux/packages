# pango -- line breaking, bidirectional reordering and font selection. Every
# label in every GTK application is laid out here.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://download.gnome.org/sources/pango/1.56/pango-1.56.3.tar.xz
SRC_SHA256=2606252bc25cd8d24e1b7f7e92c3a272b37acd6734347b73b47a482834ba2491
SRC_DIR=pango-1.56.3

MESON_ARGS="-Dintrospection=enabled -Dxft=disabled -Dcairo=enabled \
-Dfontconfig=enabled -Dfreetype=enabled -Ddocumentation=false -Dbuild-testsuite=false"
