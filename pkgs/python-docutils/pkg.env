# python-docutils -- packaged for ONE PROGRAM: rst2man.
#
# mutter needs it and cannot be told not to. mutter-48.4/meson.build:732 calls
# subdir('doc/man') UNCONDITIONALLY -- it sits outside the `if
# have_documentation` block that guards doc/reference two lines below -- and
# doc/man/meson.build:3 is
#
#     rst2man = find_program('rst2man')
#
# with no required:false. So there is no -Ddocs, no -Dman and no flag of any
# kind that avoids it: mutter does not build without rst2man. BLFS agrees and
# lists docutils FIRST in mutter's Required set.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://files.pythonhosted.org/packages/source/d/docutils/docutils-0.21.2.tar.gz
SRC_SHA256=3a6b18732edf182daa3cd12775bbb338cf5691468f91eeeb109deff6ebfa986f
SRC_DIR=docutils-0.21.2

# Pure Python -- the module and a set of console scripts, nothing compiled --
# so it is built once and installed everywhere, like the other python-* recipes.
PKG_ARCH=any
