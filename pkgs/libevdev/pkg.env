# libevdev -- the layer between raw /dev/input/event* and libinput. It keeps
# track of a device's state so a client that misses an event can resynchronise
# rather than losing a key that is still held down.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://www.freedesktop.org/software/libevdev/libevdev-1.13.4.tar.xz
SRC_SHA256=f00ab8d42ad8b905296fab67e13b871f1a424839331516642100f82ad88127cd
SRC_DIR=libevdev-1.13.4

CONFIGURE_ARGS="--disable-static --disable-documentation"
