# libffi -- how gobject-introspection calls a C function it only learned about
# at runtime, which is the mechanism the whole GNOME JavaScript stack rests on.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/libffi/libffi/releases/download/v3.4.8/libffi-3.4.8.tar.gz
SRC_SHA256=bc9842a18898bfacb0ed1252c4febcc7e78fa139fd27fdc7a3e30d9d9356119b
SRC_DIR=libffi-3.4.8

# Deliberately not --with-gcc-arch=native, which upstream and BLFS both suggest:
# it tunes the build for whatever machine happened to compile it, which is
# exactly wrong for a package that is published and installed elsewhere.
CONFIGURE_ARGS="--disable-static --disable-multi-os-directory"
