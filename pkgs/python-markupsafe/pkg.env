# python-markupsafe -- jinja2's one dependency, and jinja2 is what elogind's
# meson build renders its generated sources with.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://files.pythonhosted.org/packages/source/M/MarkupSafe/markupsafe-3.0.2.tar.gz
SRC_SHA256=ee55d3edf80167e48ea11a923c7386f4669df67d7994554387f84e7d8b0a2bf0
SRC_DIR=markupsafe-3.0.2

# The C accelerator is deliberately not built (see install.sh), so what ships is
# pure Python and identical everywhere.
PKG_ARCH=any
