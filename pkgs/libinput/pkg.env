# libinput -- everything between a device node and a pointer on screen: tap to
# click, two-finger scroll, palm rejection, pointer acceleration, key repeat.
#
# mutter delegates all of it here rather than implementing any of it, so a
# session without libinput has no working touchpad and no working keyboard --
# not a degraded one.
#
# It finds its devices through udev, which is why eudev is a hard runtime
# dependency and not merely a build one.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://gitlab.freedesktop.org/libinput/libinput/-/archive/1.28.1/libinput-1.28.1.tar.gz
SRC_SHA256=a13f8c9a7d93df3c85c66afd135f0296701d8d32f911991b7aa4273fdd6a42a3
SRC_DIR=libinput-1.28.1

# A GitLab archive URL ends in the bare tag.
SRC_FILE=libinput-1.28.1.tar.gz

# debug-gui needs GTK, which is built several tiers above this one; libwacom is
# for drawing tablets and is not packaged; the documentation is sphinx and
# doxygen. All three are diagnostics or extras, none is on the path to a
# working pointer.
MESON_ARGS="-Ddebug-gui=false -Dlibwacom=false -Ddocumentation=false -Dtests=false"
