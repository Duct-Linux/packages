# xkeyboard-config -- the keymap database libxkbcommon compiles from.
#
# It is data, not code, but it is the difference between a keyboard that types
# and one that does not: libxkbcommon resolves every layout name against this
# tree at runtime, and mutter has no keymap without it.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://www.x.org/pub/individual/data/xkeyboard-config/xkeyboard-config-2.44.tar.xz
SRC_SHA256=54d2c33eeebb031d48fa590c543e54c9bcbd0f00386ebc6489b2f47a0da4342a
SRC_DIR=xkeyboard-config-2.44

# /usr/share/X11/xkb is where libxkbcommon looks by default; naming it here
# rather than relying on the default keeps the two from drifting.
MESON_ARGS="-Dxkb-base=/usr/share/X11/xkb -Dcompat-rules=false"

PKG_ARCH=any
