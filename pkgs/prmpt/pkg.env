# Upstream's AppImages are used because a source build currently needs Bun,
# Tauri, Zig 0.15 and Rust 1.93; Duct packages Rust but not the other three.
case ${TARGET:-$(uname -m)} in
	x86_64*)
		SRC_URL=https://github.com/dssnet/Prmpt/releases/download/v0.7.5/Prmpt_0.7.5_amd64.AppImage
		SRC_SHA256=f907d35cbb20aa0938a866bcb0f04783ff8ad7a9e13d809b43e0a648433ed438
		SRC_FILE=Prmpt_0.7.5_amd64.AppImage
		;;
	aarch64*|arm64*)
		SRC_URL=https://github.com/dssnet/Prmpt/releases/download/v0.7.5/Prmpt_0.7.5_aarch64.AppImage
		SRC_SHA256=69817aa6d6403a4809c55d275dc786cf0803f5fd2d87a3257c3b7f8d11895c2d
		SRC_FILE=Prmpt_0.7.5_aarch64.AppImage
		;;
	*) echo "prmpt: unsupported target ${TARGET:-$(uname -m)}" >&2; return 1 2>/dev/null || exit 1 ;;
esac
# The payload is the verified AppImage itself. The launcher below uses the
# AppImage runtime's extract-and-run path, so Duct does not need legacy FUSE 2.
SRC_DIR=
