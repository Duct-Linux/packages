# itstool -- merges translations into XML using the W3C ITS rules.
#
# Packaged for one chain: appstream requires it to build its metainfo
# translations, and libadwaita requires appstream. Without it the GTK widget
# library does not build, which is a long way from anything that looks like
# translation tooling.
#
# It is a Python program that imports libxml2's bindings directly, which is why
# libxml2 is now built --with-python. That was the actual blocker: libxml2 had
# been built without them on the reasoning that nothing imports libxml2 from
# Python, and this is what does.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=http://files.itstool.org/itstool/itstool-2.0.7.tar.bz2
SRC_SHA256=6b9a7cd29a12bb95598f5750e8763cee78836a1a207f85b74d8b3275b27e87ca
SRC_DIR=itstool-2.0.7

PKG_ARCH=any
