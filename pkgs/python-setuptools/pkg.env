# python-setuptools -- a build-time dependency of gobject-introspection, whose
# meson build checks for it by name and stops if it is absent:
#
#   meson.build:29:8: ERROR: python3 is missing modules: setuptools
#
# It is absent because Duct's python is configured --without-ensurepip, so the
# interpreter ships with no pip and therefore no setuptools -- and since Python
# 3.12 there is no distutils in the standard library to fall back on either.
# g-ir-scanner uses it to locate its own installed data.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://files.pythonhosted.org/packages/source/s/setuptools/setuptools-80.9.0.tar.gz
SRC_SHA256=f36b47402ecde768dbfafc46e8e4207b4360c654f1f3bb84475f0a28628fb19c
SRC_DIR=setuptools-80.9.0

PKG_ARCH=any
