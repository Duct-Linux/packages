# eudev -- udev, forked from systemd's and kept buildable on its own.
#
# Not optional for a desktop: libinput enumerates input devices through libudev
# and refuses to start without it, mutter finds DRM devices the same way, and
# elogind hands out device access per seat using udev's tagging. A GNOME session
# on a machine with no udev does not degrade, it does not start.
#
# eudev rather than udev extracted from the systemd tarball, which is what LFS
# sysv does: the systemd build wants a large slice of its own tree and a python
# toolchain to render it, and this is an autotools package that needs gperf and
# nothing else. The cost is an older hwdb -- see the note in post-install.sh.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/eudev-project/eudev/releases/download/v3.2.14/eudev-3.2.14.tar.gz
SRC_SHA256=8da4319102f24abbf7fff5ce9c416af848df163b29590e666d334cc1927f006f
SRC_DIR=eudev-3.2.14

# rootprefix= (empty) with libdir under /usr is the merged-/usr spelling: eudev
# otherwise splits itself between / and /usr, and here / is a symlink farm
# pointing back into /usr.
#
# --disable-manpages for the same reason as kmod: no docbook stylesheets.
CONFIGURE_ARGS="--prefix=/usr --bindir=/usr/bin --sbindir=/usr/sbin \
--libdir=/usr/lib --sysconfdir=/etc --libexecdir=/usr/lib \
--with-rootprefix= --with-rootlibdir=/usr/lib \
--enable-hwdb --disable-manpages --disable-static"
