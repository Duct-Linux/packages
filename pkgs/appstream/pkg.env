# appstream -- the metadata format describing an application: its name in every
# language, its icon, its screenshots, its release notes.
#
# Packaged because libadwaita requires it -- AdwAboutDialog reads an
# application's metainfo to fill in its own contents -- so it is on the path to
# GTK 4's own widget library rather than being a software-centre feature.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://www.freedesktop.org/software/appstream/releases/AppStream-1.0.4.tar.xz
SRC_SHA256=2d218348067f98c4f34a3ffe2d8219ad9f504b1b2481f1872dec66c77bf37509
SRC_DIR=AppStream-1.0.4

# compose is the catalogue-building tool a distribution runs to produce its own
# metadata; it needs several more libraries and nothing on a live ISO runs it.
# stemming is snowball, which is not packaged, and only affects search ranking.
# svg-support and zstd-support are off deliberately, and not for size: SVG
# support reaches for librsvg, which is Rust, and would make appstream the
# second package in the set needing a Rust build image -- for icon rendering
# that only the catalogue-building tool uses, and compose is off anyway. zstd is
# not packaged.
MESON_ARGS="-Dcompose=false -Dstemming=false -Dapidocs=false -Dinstall-docs=false \
-Ddocs=false -Dvapi=false -Dqt=false -Dsystemd=false \
-Dsvg-support=false -Dzstd-support=false"
