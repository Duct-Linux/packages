# iso-codes -- the translated names of languages, countries and scripts.
#
# gnome-control-center's region panel, gnome-desktop's language chooser and
# gdm's greeter all read these lists; without them the pickers are empty.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://salsa.debian.org/iso-codes-team/iso-codes/-/archive/v4.18.0/iso-codes-v4.18.0.tar.bz2
SRC_SHA256=e6351276de5bb5c91c17546c4d3f53bee9494f3f14f5db7594a19d6cdd01d0f3
SRC_DIR=iso-codes-v4.18.0

# A GitLab archive URL ends in the bare tag, so without this the tarball caches
# under a name that says nothing about what is in it.
SRC_FILE=iso-codes-4.18.0.tar.bz2

# JSON and translation catalogues only -- no compiled code, so the same bytes
# install on every machine.
PKG_ARCH=any
