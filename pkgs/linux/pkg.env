# linux -- the kernel itself, as opposed to linux-headers.
#
# Both packages are built from the same tarball and the same pin, which is not
# an accident: the headers userspace compiles against and the kernel that
# provides those interfaces at runtime should never be two different versions.
# That is why the source pin lives in versions.env and is shared, rather than
# each recipe naming its own.
#
# The two are separate packages because they are needed in different places.
# Every image needs the headers -- glibc will not configure without them. Only
# something that boots needs the kernel, and it is 100 MB of modules.
SRC_URL=$LINUX_URL
SRC_SHA256=$LINUX_SHA256
SRC_DIR=$LINUX_SRCDIR

# The configuration is assembled rather than shipped whole: the architecture's
# own defconfig, then config/common.config, then config/<arch>.config. See
# build.sh for why.
