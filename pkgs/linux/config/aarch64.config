# arm64 settings, merged after common.config.
#
# arm64 has no legacy console to fall back on: there is no BIOS text mode, no
# i8042, and no VGA. Everything that produces output has to be asked for
# explicitly, which is why this file is mostly serial drivers.

CONFIG_ARM64=y
CONFIG_SMP=y

# QEMU's `virt` machine, which is where this is tested, and the platforms most
# likely to be booted from a USB stick.
CONFIG_ARCH_VIRT=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_HOST_COMMON=y

# The serial ports that actually appear on arm64. PL011 is QEMU's; the others
# cover the common server and developer boards. All built in, because a serial
# console that needs a module is a serial console that shows nothing when the
# boot fails.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y

# Early output, before the real console driver is up. This is the difference
# between diagnosing a failed boot and guessing at it.
CONFIG_SERIAL_EARLYCON=y
CONFIG_EARLY_PRINTK=y

# ACPI exists on arm64 servers; device tree covers everything else. Both.
CONFIG_ACPI=y
CONFIG_OF=y

# The generic timer and GIC, without which the machine does not come up at all.
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_GIC_V3_ITS=y

# Device trees are installed alongside the kernel. QEMU's virt machine
# generates its own and needs none of them, but a board that needs one and
# cannot find it does not boot, and they cost a few megabytes.
CONFIG_ARM64_MODULE_PLTS=y
