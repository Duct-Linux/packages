# x86_64 settings, merged after common.config.
#
# Only what does not exist on other architectures belongs here. Everything that
# happens to be x86-only in practice but is spelled the same way everywhere --
# AHCI, NVMe, xHCI -- stays in common.config, where one edit covers both.

CONFIG_64BIT=y
CONFIG_SMP=y

# The x86 EFI console path. efifb is what draws the boot messages before any
# real GPU driver loads, and on a UEFI-only ISO there is nothing behind it.
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_X86_SYSFB=y

# The PC keyboard controller. Absent, a physical machine boots to a console
# that cannot be typed at, which is a hard failure to diagnose from the other
# side of a screenshot.
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y

# The serial console an automated boot test watches.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y

# Firmware-provided identity, which every hardware-quirk table keys off.
CONFIG_DMI=y
CONFIG_DMIID=y

# Microcode is loaded from /lib/firmware, which the live ISO does not carry
# yet; the kernel handles its absence quietly and this stays on so that adding
# a firmware package later needs no kernel change.
CONFIG_MICROCODE=y
CONFIG_MICROCODE_INTEL=y
CONFIG_MICROCODE_AMD=y

# ACPI, without which nothing on a modern x86 machine enumerates.
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_THERMAL=y

# Hypervisor guest support: this ISO runs under QEMU/KVM long before it runs on
# metal.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
