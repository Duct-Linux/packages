# What Duct needs on top of the architecture's defconfig.
#
# The base is upstream's defconfig, not a configuration written here. A
# hand-maintained 12,000-line .config is a liability: it goes stale at every
# release, nobody can review a diff of it, and the reason any particular symbol
# is set is lost within a month. defconfig is maintained by the people who
# maintain the drivers, and this file is the reviewable part -- the settings
# that are Duct's decision rather than upstream's.
#
# Symbols named here that an architecture does not have are reported by
# merge_config.sh and then ignored, which is why the arch-specific files are
# small: only genuinely arch-specific things need to move out of this one.

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

# LOCALVERSION_AUTO would append a git description, and there is no git tree
# here -- it would silently produce a different kernel release string depending
# on whether the source came from a tarball or a checkout, and the release
# string is the module search path.
CONFIG_LOCALVERSION="-duct"
# CONFIG_LOCALVERSION_AUTO is not set

# ---------------------------------------------------------------------------
# Booting from a live medium
#
# This is the whole point of the live ISO, and every one of these is required:
# the kernel unpacks an initramfs, the initramfs finds an ISO9660 or FAT
# filesystem, mounts a squashfs image out of it through a loop device, and
# stacks a tmpfs over it with overlayfs so the running system can be written to.
# Miss one and the boot stops at "unable to mount root fs".
# ---------------------------------------------------------------------------

CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y

CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8

CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y

CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_OVERLAY_FS_XINO_AUTO=y
CONFIG_OVERLAY_FS_METACOPY=y

CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=y

# The ISO carries a FAT EFI system partition, and that is also how a USB stick
# written from it presents itself.
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Reading and writing the disks a live system is most likely to be pointed at.
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_BTRFS_FS=m
CONFIG_XFS_FS=m
CONFIG_F2FS_FS=m
CONFIG_NTFS3_FS=m
# =y, not =m, and the difference is load-bearing.
#
# duct-live's boot script coldplugs by walking sysfs modaliases -- find
# /sys/devices -name modalias, then modprobe them. That loads DEVICE drivers.
# A filesystem advertises no modalias, is never matched, and is never loaded,
# so as a module FUSE would simply never appear: /dev/fuse absent on a system
# that looks fully configured, and the failure surfacing far away in flatpak's
# revokefs-fuse or in any AppImage.
#
# A modprobe line in the boot script would also work and would be deletable by
# the next person tidying it, with its absence silent in exactly the same way.
# About 30 KB built in is the cheaper guarantee.
CONFIG_FUSE_FS=y

CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y

# ---------------------------------------------------------------------------
# Firmware
#
# EFI only. Duct's gcc is --disable-multilib, so there is no 32-bit compiler
# and therefore no way to build GRUB's i386-pc target -- the ISO boots through
# UEFI or not at all. See images/README.md.
# ---------------------------------------------------------------------------

CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_EFI_RUNTIME_WRAPPERS=y

# ---------------------------------------------------------------------------
# Storage
#
# Built in rather than modular wherever the initramfs might need it before it
# has a modules directory to load from. The initramfs carries no modules today;
# keeping the controllers built in is what makes that safe.
# ---------------------------------------------------------------------------

CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_CHR_DEV_SG=m
CONFIG_SCSI_LOWLEVEL=y

CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SATA_AHCI_PLATFORM=y
CONFIG_ATA_GENERIC=y

CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y

CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y

CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=m

# USB, and specifically USB mass storage: a live ISO written to a stick is the
# common case, and it is the one where a missing driver is least recoverable.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# ---------------------------------------------------------------------------
# Virtual machines
#
# The ISO is tested under QEMU before it is tested anywhere else, and virtio is
# how QEMU presents everything. Built in, so a virtual machine boots with no
# modules at all.
# ---------------------------------------------------------------------------

CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_INPUT=y
CONFIG_SCSI_VIRTIO=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_DRM_VIRTIO_GPU=y

# ---------------------------------------------------------------------------
# Console and input
#
# Two consoles matter and they are not the same one. A serial console is how
# an automated QEMU boot is observed; a virtual terminal on a framebuffer is
# how a person uses the thing. Both are built in.
# ---------------------------------------------------------------------------

CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=y

CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=m
CONFIG_SERIO=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_SUPPORT=y
CONFIG_USB_HID=y
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_APPLE=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_MICROSOFT=m

# ---------------------------------------------------------------------------
# Graphics
#
# DRM/KMS rather than plain framebuffer, because the desktop package set that
# will be layered on this ISO later talks to KMS and to evdev, and nothing
# else. simpledrm is the fallback that matters most: it drives whatever
# framebuffer the firmware left behind, so a machine with no supported GPU
# still gets a console and a Wayland session rather than a black screen.
#
# The real drivers are modules. Built in they would add tens of megabytes of
# firmware-loading code to an image that has to be decompressed before any
# storage driver exists.
# ---------------------------------------------------------------------------

CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_PANEL_ORIENTATION_QUIRKS=y

CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_RADEON=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_VMWGFX=m
CONFIG_DRM_QXL=m
CONFIG_DRM_BOCHS=m
CONFIG_DRM_CIRRUS_QEMU=m
CONFIG_DRM_UDL=m

CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FONT_8x16=y

# Sound, for the same reason as the GPU drivers: the desktop set will want it,
# and adding it to the kernel later means rebuilding the kernel later.
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_PCM=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_INTEL_DSP_CONFIG=m

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_R8169=m
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m

# ---------------------------------------------------------------------------
# What a session manager expects to find
#
# None of this is needed to reach a shell. All of it is needed by the first
# thing that tries to manage a user session, and finding out one release later
# that the kernel cannot do cgroups is an avoidable rebuild.
# ---------------------------------------------------------------------------

CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_PSI=y
CONFIG_AUTOFS_FS=y
CONFIG_FANOTIFY=y
CONFIG_INOTIFY_USER=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_POSIX_MQUEUE=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_CONFIGFS_FS=y
CONFIG_DEBUG_FS=y

# ---------------------------------------------------------------------------
# Modules
# ---------------------------------------------------------------------------

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y

# Signing needs a key. Generating one during the build would make the package
# unreproducible -- two builds of the same source would differ in the key and
# in every signature -- and embedding a checked-in private key would be
# security theatre. Duct's answer to "is this module the one we built" is the
# signed repository the package came from.
# CONFIG_MODULE_SIG is not set
# CONFIG_SYSTEM_TRUSTED_KEYRING is not set

# ---------------------------------------------------------------------------
# Size
#
# Debug info is the single largest contributor to a kernel package, and BTF
# additionally needs pahole, which is not packaged. Both off.
# ---------------------------------------------------------------------------

# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_GDB_SCRIPTS is not set
