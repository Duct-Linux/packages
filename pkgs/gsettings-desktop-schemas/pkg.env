# gsettings-desktop-schemas -- the settings definitions the whole desktop shares:
# the background, the interface font, the input sources, the power policy.
#
# Schemas are XML and the compiled gschemas.compiled is regenerated at image
# assembly, so nothing here is machine-specific.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://download.gnome.org/sources/gsettings-desktop-schemas/48/gsettings-desktop-schemas-48.0.tar.xz
SRC_SHA256=e68f155813bf18f865a8b2c8e9d473588b6ccadcafbb666ab788857c6c2d1bd3
SRC_DIR=gsettings-desktop-schemas-48.0

MESON_ARGS="-Dintrospection=true"
