# rust -- the toolchain uutils-coreutils is built with.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
#
# The source tarball is 513 MB because it vendors both the crates and the whole
# of llvm-project. That is what makes this build offline: unlike
# uutils-coreutils, nothing is fetched from crates.io.
SRC_URL=https://static.rust-lang.org/dist/rustc-1.97.1-src.tar.gz
SRC_SHA256=622c2b429c53cbfdc0dd3a51d03554e91cd63ebec1912c1f5709640cdfef1a9d
SRC_DIR=rustc-1.97.1-src
