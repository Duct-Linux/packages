# libxcb -- the modern X protocol binding. libX11 is a thin layer over it, and
# libxkbcommon's X11 support talks to it directly.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://xorg.freedesktop.org/archive/individual/lib/libxcb-1.17.0.tar.xz
SRC_SHA256=599ebf9996710fea71622e6e184f3a8ad5b43d0e5fa8c4e407123c88a59a6d55
SRC_DIR=libxcb-1.17.0

# Almost all of libxcb is generated from xcb-proto's XML by a Python script at
# build time, which is why python is a build dependency of an X library.
CONFIGURE_ARGS="--disable-static --without-doxygen --docdir=/usr/share/doc/libxcb-1.17.0"
