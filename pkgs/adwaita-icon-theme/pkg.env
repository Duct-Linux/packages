# adwaita-icon-theme -- every icon GNOME draws that is not an application's own.
#
# Built after gtk4 because gtk4-update-icon-cache is what compiles the index;
# the theme is data either way, which is why it is stamped "any".
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://download.gnome.org/sources/adwaita-icon-theme/48/adwaita-icon-theme-48.0.tar.xz
SRC_SHA256=847068888650d9673115be6dbf2bfdc31a46aebc528a6a9db4420e60e656b8d4
SRC_DIR=adwaita-icon-theme-48.0

PKG_ARCH=any
