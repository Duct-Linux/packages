# libadwaita -- the widgets and the stylesheet that make a GTK 4 application
# look like a GNOME one, and the adaptive layout containers everything from
# gnome-control-center to nautilus is built out of.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://download.gnome.org/sources/libadwaita/1.7/libadwaita-1.7.2.tar.xz
SRC_SHA256=28ee2ff589c6debe47af9da7a56e37c97d6849e003918a4b223f690d25f960be
SRC_DIR=libadwaita-1.7.2

MESON_ARGS="-Dexamples=false -Dtests=false -Dvapi=false -Dgtk_doc=false -Dintrospection=enabled"
