# wayland -- libwayland-client, libwayland-server and wayland-scanner.
#
# The display protocol the whole session speaks: mutter is the server, every
# GTK application is a client, and wayland-scanner is what turns a protocol XML
# file into the glue both ends link against.
#
# libffi is not incidental. Wayland dispatches protocol messages by building a
# call frame at runtime from the argument signature in the XML, which is exactly
# what libffi exists to do -- there is no generated switch statement underneath.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://gitlab.freedesktop.org/wayland/wayland/-/releases/1.23.1/downloads/wayland-1.23.1.tar.xz
SRC_SHA256=864fb2a8399e2d0ec39d56e9d9b753c093775beadc6022ce81f441929a81e5ed
SRC_DIR=wayland-1.23.1

# documentation=false: rendered with doxygen and xsltproc from docbook, neither
# stylesheet set being packaged. dtd_validation stays on -- it is libxml2, which
# is packaged, and it is what catches a malformed protocol file at build time
# rather than at runtime.
MESON_ARGS="-Ddocumentation=false -Dtests=false -Ddtd_validation=true"
