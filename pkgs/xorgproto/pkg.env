# xorgproto -- the X protocol headers. Headers and pkg-config files only.
#
# Packaged even though Duct's session is Wayland: gtk4, mutter and several
# GNOME components include these unconditionally, and libxcb's protocol
# descriptions are generated against them.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://www.x.org/pub/individual/proto/xorgproto-2024.1.tar.xz
SRC_SHA256=372225fd40815b8423547f5d890c5debc72e88b91088fbfb13158c20495ccb59
SRC_DIR=xorgproto-2024.1

# The legacy headers are the ones only an X server or a pre-XCB client wants;
# nothing in this package set does.
MESON_ARGS="-Dlegacy=false"

PKG_ARCH=any
