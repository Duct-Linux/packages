# attr -- libattr, underneath acl and therefore underneath every file manager
# that shows a file's extended attributes.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
# download-mirror rather than download.savannah directly, and this is
# PERMANENT rather than a workaround for the outage that prompted it:
# the mirror is Savannah's own round-robin across several hosts, so it
# is strictly more available than the single origin, and SRC_SHA256
# makes the host an implementation detail rather than a trust decision.
# Do not "restore" the canonical URL as a tidy-up -- that reintroduces
# a single point of failure for no property worth having.
SRC_URL=https://download-mirror.savannah.gnu.org/releases/attr/attr-2.5.2.tar.gz
SRC_SHA256=39bf67452fa41d0948c2197601053f48b3d78a029389734332a6309a680c6c87
SRC_DIR=attr-2.5.2

CONFIGURE_ARGS="--disable-static --sysconfdir=/etc --docdir=/usr/share/doc/attr-2.5.2"
