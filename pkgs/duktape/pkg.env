# duktape -- polkit's rule interpreter.
#
# polkit needs a JavaScript engine to evaluate /etc/polkit-1/rules.d, and offers
# a choice of mozjs or duktape. duktape is two C files; mozjs is the SpiderMonkey
# build, which needs Rust and clang. Nothing about polkit's rules justifies the
# larger of those, so duktape it is.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://duktape.org/duktape-2.7.0.tar.xz
SRC_SHA256=90f8d2fa8b5567c6899830ddef2c03f3c27960b11aca222fa17aa7ac613c2890
SRC_DIR=duktape-2.7.0
