# linux-pam -- the authentication stack gdm, elogind and shadow all talk to.
# Without it there is no way for a session to be authenticated at all, and
# elogind will not even register one.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/linux-pam/linux-pam/releases/download/v1.7.0/Linux-PAM-1.7.0.tar.xz
SRC_SHA256=57dcd7a6b966ecd5bbd95e1d11173734691e16b68692fa59661cdae9b13b1697
SRC_DIR=Linux-PAM-1.7.0

# 1.7.0 is meson-only -- the autotools build was dropped, which is worth knowing
# before wondering where ./configure went.
#
# securedir is where every PAM module lands and where every PAM-linked program
# looks; /usr/lib/security is the merged-/usr spelling of it.
#
# docs=disabled: rendered from docbook through xsltproc and the stylesheets are
# not packaged. logind=disabled because elogind is built after this -- pam_
# elogind comes from elogind's own package, not from here.
MESON_ARGS="-Ddocs=disabled -Daudit=disabled -Dselinux=disabled -Dnis=disabled \
-Dlogind=disabled -Dopenssl=disabled -Dpam_userdb=disabled -Dexamples=false \
-Dxtests=false -Dsecuredir=/usr/lib/security \
-Ddocdir=/usr/share/doc/Linux-PAM-1.7.0"
