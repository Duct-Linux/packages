# libwebp -- WebP decoding. Enough of the web is WebP now that a browser or an
# image viewer without it looks broken rather than limited.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-1.5.0.tar.gz
SRC_SHA256=7d6fab70cf844bf6769077bd5d7a74893f8ffd4dfb42861745750c63c2a5c92c
SRC_DIR=libwebp-1.5.0

CONFIGURE_ARGS="--disable-static --enable-libwebpmux --enable-libwebpdemux"
