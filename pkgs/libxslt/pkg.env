# libxslt -- for xsltproc, which is how docbook manual pages are rendered. dbus,
# polkit and shadow all reach for it during their builds.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://download.gnome.org/sources/libxslt/1.1/libxslt-1.1.43.tar.xz
SRC_SHA256=5a3d6b383ca5afc235b171118e90f5ff6aa27e9fea3303065231a6d403f0183a
SRC_DIR=libxslt-1.1.43

CONFIGURE_ARGS="--disable-static --without-python"
