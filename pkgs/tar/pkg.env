# tar -- generated by tools/gen-recipes.sh, safe to edit.
# Source pins come from ../versions.env so a bump is one file.

SRC_URL=$TAR_URL
SRC_SHA256=$TAR_SHA256
SRC_DIR=$TAR_SRCDIR

CONFIGURE_ARGS="--disable-nls"

# tar's configure probes whether mknod can create a FIFO without privileges and
# refuses to continue as root, because the answer it would record is not the one
# a normal user would get. Package builds here run as root inside the container,
# exactly as LFS chapter 8 does inside its chroot, so the check is bypassed the
# same way it is there.
FORCE_UNSAFE_CONFIGURE=1
