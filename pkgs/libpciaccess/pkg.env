# libpciaccess -- enumerates PCI devices without parsing /proc by hand.
#
# libdrm uses it to match a DRM node to the card behind it, which is how mesa
# decides which driver to load. On a live ISO that decision is the difference
# between hardware acceleration and llvmpipe.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://www.x.org/pub/individual/lib/libpciaccess-0.18.1.tar.xz
SRC_SHA256=4af43444b38adb5545d0ed1c2ce46d9608cc47b31c2387fc5181656765a6fa76
SRC_DIR=libpciaccess-0.18.1

# 0.18 is meson-only; the autotools build was dropped.
MESON_ARGS="-Dzlib=disabled"
