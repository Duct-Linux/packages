# xtrans -- not a library. It is a set of .c files that libX11 and libxcb
# #include directly to abstract over sockets, so it installs headers and a
# pkg-config file and nothing else.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://www.x.org/pub/individual/lib/xtrans-1.6.0.tar.xz
SRC_SHA256=faafea166bf2451a173d9d593352940ec6404145c5d1da5c213423ce4d359e92
SRC_DIR=xtrans-1.6.0

CONFIGURE_ARGS="--docdir=/usr/share/doc/xtrans-1.6.0"

PKG_ARCH=any
