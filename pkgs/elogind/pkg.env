# elogind -- logind, extracted from systemd so it can run without it.
#
# This is the piece that makes a graphical session possible at all on a system
# with a sysv init. mutter asks logind to open the DRM device and the input
# devices, because on a seat-managed system it is not allowed to open them
# itself; gnome-shell asks logind whether the session is active before it will
# draw; gdm creates the session through it; and the lock, suspend and switch-user
# paths are all logind D-Bus calls. Without it GNOME does not start.
#
# seatd is deliberately not packaged alongside it. seatd exists for compositors
# that speak libseat; mutter speaks logind directly, so seatd would be a second
# seat manager with nothing using it.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/elogind/elogind/archive/v255.17/elogind-255.17.tar.gz
SRC_SHA256=a9725ae3f73f8d910de84c108bc11bfd4c782bef6a4190b2ec70c5d2f22344db
SRC_DIR=elogind-255.17

# A GitHub archive URL ends in the bare tag.
SRC_FILE=elogind-255.17.tar.gz

# cgroup-controller=elogind names the cgroup hierarchy elogind manages; with the
# default it claims systemd's name, which is a lie on a system that has none.
#
# dev-kvm-mode=0660 rather than 0666: the group already gates access, and a
# world-writable /dev/kvm on a live ISO is a needlessly large door.
#
# man and html are off because the docbook stylesheets are not packaged.
# jinja2 is still required regardless -- elogind renders generated sources under
# src/login and src/libelogind through it, not just documentation.
MESON_ARGS="-Dmode=release -Dman=false -Dhtml=false \
-Ddocdir=/usr/share/doc/elogind-255.17 \
-Dcgroup-controller=elogind -Ddefault-hierarchy=unified -Ddev-kvm-mode=0660 \
-Dpamlibdir=/usr/lib/security -Dpamconfdir=/etc/pam.d \
-Dutmp=false -Dtests=false -Dsmack=false -Dselinux=disabled -Daudit=disabled \
-Dpam=enabled -Dacl=enabled"
