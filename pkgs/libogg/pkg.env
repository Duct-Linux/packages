# libogg -- the Ogg container format, and here only because libvorbis needs it.
#
# Packaged for the desktop event sounds: libcanberra requires libvorbis
# unconditionally, libvorbis requires libogg, and the freedesktop sound theme
# ships .oga files, which are Vorbis audio in an Ogg container. Nothing else in
# this tree links it today.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://downloads.xiph.org/releases/ogg/libogg-1.3.6.tar.xz
SRC_SHA256=5c8253428e181840cd20d41f3ca16557a9cc04bad4a3d04cce84808677fa1061
SRC_DIR=libogg-1.3.6

# --disable-static for the usual reason: nothing here links statically, and a
# .a doubles the package for no consumer.
CONFIGURE_ARGS="--disable-static"
