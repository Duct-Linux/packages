# xorg-util-macros -- the m4 macros every X.Org autotools package expands at
# configure time. It installs one .pc file and a directory of m4; there is
# nothing to run and nothing to link.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://www.x.org/pub/individual/util/util-macros-1.20.2.tar.xz
SRC_SHA256=9ac269eba24f672d7d7b3574e4be5f333d13f04a7712303b1821b2a51ac82e8e
SRC_DIR=util-macros-1.20.2

CONFIGURE_ARGS="--datarootdir=/usr/share"

PKG_ARCH=any
