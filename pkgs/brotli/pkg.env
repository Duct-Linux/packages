# brotli -- freetype decompresses WOFF2 web fonts with it.
#
# Not on the critical path for a desktop that only renders local fonts, but it
# is two hundred kilobytes and it is what stops a downloaded font silently
# failing to load in a browser or an application that embeds one.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/google/brotli/archive/v1.1.0/brotli-1.1.0.tar.gz
SRC_SHA256=e720a6ca29428b803f4ad165371771f5398faba397edf6778837a18599ea13ff
SRC_DIR=brotli-1.1.0

# A GitHub archive URL ends in the bare tag.
SRC_FILE=brotli-1.1.0.tar.gz
