# elfutils -- here for libelf, which the kernel's objtool links against.
#
# objtool is built for x86 whenever CONFIG_OBJTOOL is set, and that is selected
# by so much of the x86 configuration that turning it off is not a realistic
# option. arm64 does not build objtool at all, so on that architecture this
# package is carried rather than used -- which is the right trade: the recipe
# set stays the same on every architecture, and the one that needs libelf finds
# it there.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://sourceware.org/elfutils/ftp/0.193/elfutils-0.193.tar.bz2
SRC_SHA256=7857f44b624f4d8d421df851aaae7b1402cfe6bcdd2d8049f15fc07d3dde7635
SRC_DIR=elfutils-0.193

# debuginfod is a network service client and pulls in libcurl; "dummy" builds
# the libdebuginfod entry points as stubs so libdw still links without it.
#
# bzlib, lzma and zstd only decompress debug sections in already-compressed
# ELF objects, which nothing in Duct produces. Naming them explicitly means the
# result does not depend on which compression libraries happen to be installed
# in the build image.
CONFIGURE_ARGS="--disable-nls \
	--disable-debuginfod --enable-libdebuginfod=dummy \
	--enable-deterministic-archives \
	--with-zlib --without-bzlib --without-lzma --without-zstd"

# elfutils compiles with a very aggressive warning set and treats several of
# them as errors. gcc 15 finds new ones in code that upstream has not caught up
# with yet, and a warning in a library this stable is not worth failing a build
# over.
CFLAGS="-O2 -g0 -Wno-error"
