# util-linux -- mount, umount, blkid, losetup, switch_root, fdisk, lsblk.
#
# The live ISO cannot boot without this set. The initramfs uses a static
# busybox and needs nothing from here, but the moment the real root is running
# it wants a real mount(8) and a real blkid(8), and libmount and libblkid are
# what every later layer -- a desktop session manager above all -- expects to
# find when it wants to know what is mounted where.
#
# Pinned in versions.env already: it is an LFS package, and was pinned there
# long before anything used it.
SRC_URL=$UTIL_LINUX_URL
SRC_SHA256=$UTIL_LINUX_SHA256
SRC_DIR=$UTIL_LINUX_SRCDIR

# Four groups of flags, for four different reasons.
#
# Paths: Duct is merged-/usr and puts runtime state in /run.
#
# Ownership: tape cannot represent setuid, setgid or sticky bits at all, and
# `make install` here would try to chown root and set the mount(8) setuid bit.
# Disabling that is not a hardening choice -- it is the only way the install
# stage completes as a non-root packaging step.
#
# Conflicts: `more` and `kill` are already owned by uutils-coreutils, and two
# packages claiming one path is a hard install error with no override.
#
# Absent dependencies: no PAM, no systemd, no Python bindings, and none of the
# account tools (login, su, runuser, chfn, chsh, setpriv, nologin, sulogin),
# which would all be setuid and none of which have a password database to
# consult -- Duct has no shadow package yet.
CONFIGURE_ARGS="--disable-nls --disable-static \
	--bindir=/usr/bin --sbindir=/usr/sbin --libdir=/usr/lib --runstatedir=/run \
	--disable-makeinstall-chown --disable-makeinstall-setuid \
	--disable-makeinstall-tty-setgid --disable-use-tty-group \
	--disable-more --disable-kill \
	--disable-login --disable-su --disable-runuser --disable-nologin \
	--disable-sulogin --disable-chfn-chsh --disable-setpriv \
	--disable-liblastlog2 --disable-pylibmount --without-python \
	--without-systemd --without-systemdsystemunitdir --without-udev \
	--disable-bash-completion \
	ADJTIME_PATH=/var/lib/hwclock/adjtime"
