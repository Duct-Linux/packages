# util-linux -- packaged for its libraries rather than its commands. libblkid
# and libmount are what udev identifies filesystems with and what GLib's GIO
# enumerates mounts through; libuuid is a hard dependency of mesa and of the
# X client libraries.
#
# Already pinned in versions.env: it is an LFS package, it simply had no recipe.
SRC_URL=$UTIL_LINUX_URL
SRC_SHA256=$UTIL_LINUX_SHA256
SRC_DIR=$UTIL_LINUX_SRCDIR

# login, su, nologin, chfn, chsh, setpriv and runuser are all disabled: shadow
# ships the same commands, and two packages owning one path is a hard install
# error in tape rather than a last-one-wins.
#
# --disable-liblastlog2 avoids a dependency on sqlite this early in the order;
# --disable-pylibmount avoids one on a Python development environment Duct does
# not ship.
CONFIGURE_ARGS="--bindir=/usr/bin --libdir=/usr/lib --sbindir=/usr/sbin \
--runstatedir=/run --disable-chfn-chsh --disable-login --disable-nologin \
--disable-su --disable-setpriv --disable-runuser --disable-pylibmount \
--disable-liblastlog2 --disable-static --without-python --without-systemd \
--without-systemdsystemunitdir --disable-nls \
--docdir=/usr/share/doc/util-linux-2.41.1 \
ADJTIME_PATH=/var/lib/hwclock/adjtime"
