# cbindgen -- a build-time-only tool for mozjs, and the prerequisite nobody
# asked for.
#
# WHY IT IS HERE AT ALL. SpiderMonkey's configure requires it unconditionally,
# and this was verified in the firefox-140.2.0 source rather than taken from the
# book:
#
#   js/moz.configure:43
#     include("../build/moz.configure/bindgen.configure",
#             when="--enable-compile-environment")
#
#   build/moz.configure/bindgen.configure
#     cbindgen_min_version = Version("0.27.0")
#     ... raise FatalCheckError("Cannot find cbindgen. ...")
#
# --enable-compile-environment is on for any build that compiles anything, and
# the probe is reached through set_config("CBINDGEN", cbindgen) with a
# @depends_if whose search-path argument is the ordinary PATH -- so it is always
# evaluated, and it is fatal.
#
# THE PART WORTH KNOWING: the standalone SpiderMonkey build never actually RUNS
# it. There is not one cbindgen.toml anywhere under js/ in the firefox tarball
# (there are twenty-odd elsewhere, all under toolkit/, netwerk/, servo/ and
# friends -- i.e. the browser). So this package exists to satisfy a configure
# check for a code generator with nothing to generate. That is worth writing
# down, because the natural response to "the build does not use it" is to try to
# remove it, and the check does not care.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/mozilla/cbindgen/archive/v0.29.0/cbindgen-0.29.0.tar.gz
SRC_SHA256=6697f449d4a15d814d991249a611af961c97e36d9344c7ced6df35c5c25b40cc
SRC_DIR=cbindgen-0.29.0

# BUILT IN duct/rust, NOT duct/chroot -- like uutils-coreutils, and for the same
# reason: it is Rust and there is no cargo in the standard build image. It is
# therefore in RUST_PKGS in the Makefile rather than in one of the ALL_PKGS
# groups, and CI is told the same thing separately in .github/workflows/build.yml,
# which selects the image per package by name.
#
# The consequence that is easy to miss: `make packages` had to be reordered so
# packages-rust runs BEFORE packages-native. Until now nothing native depended
# on anything in RUST_PKGS, so the order was free; mozjs is the first thing to
# make it matter.
