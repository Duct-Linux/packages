# hwdata -- pci.ids, usb.ids and the vendor tables.
#
# What turns "1002:73df" into "AMD Radeon RX 6700 XT" in the About panel, and
# what libpciaccess reads to name a device. Cosmetic on a server; on a live ISO
# it is most of what the user sees when they check their hardware was detected.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/vcrhonek/hwdata/archive/v0.394/hwdata-0.394.tar.gz
SRC_SHA256=b7c3fd7214a3b7c49d2661db127a712dc11cffd1799f793947aa1cb20aaf3298
SRC_DIR=hwdata-0.394

# A GitHub archive URL ends in the bare tag.
SRC_FILE=hwdata-0.394.tar.gz

PKG_ARCH=any
