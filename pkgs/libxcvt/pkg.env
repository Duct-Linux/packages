# libxcvt -- the VESA CVT timing generator, and Xwayland's one unconditional
# hard dependency outside the protocol headers.
#
# It computes the modeline for a given width, height and refresh rate. Xwayland
# needs it because a Wayland compositor hands it output sizes rather than
# modes, and XRandR clients under Xwayland ask for modes: hw/xwayland's
# xwayland-cvt.c turns each advertised output into a fake CRTC mode with this.
# xwayland/meson.build takes it `required: true` twice, so its absence is one
# of the few things about Xwayland that DOES fail loudly.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://www.x.org/pub/individual/lib/libxcvt-0.1.3.tar.xz
SRC_SHA256=a929998a8767de7dfa36d6da4751cdbeef34ed630714f2f4a767b351f2442e01
SRC_DIR=libxcvt-0.1.3

# NO MESON_ARGS, AND NOT BY OMISSION: libxcvt 0.1.3 ships no meson_options.txt
# at all. There is nothing to pin, which is why this is the only recipe in the
# X11 compatibility set with no flags to argue about.
#
# It links libm (`cc.find_library('m', required: false)`) and nothing else --
# the whole library is one .c file of arithmetic.
