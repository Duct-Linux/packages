# libxcvt -- the VESA CVT timing calculator, split out of the X server.
#
# Xwayland needs it and does not treat it as optional: meson.build:177 is
#
#     libxcvt_dep = dependency('libxcvt', fallback: [...], required: true)
#
# one of only a handful of hard dependency() calls in that file. The `fallback:`
# is decoration here for the usual reason -- build-meson.sh passes
# --wrap-mode=nodownload -- so a missing libxcvt is a configure failure rather
# than a subproject.
#
# BLFS 12.4, pinned here rather than in versions.env: versions.env is
# regenerated wholesale from the LFS book by tools/pin-versions.sh, so a desktop
# pin placed there is destroyed by the next `make pin`.
SRC_URL=https://www.x.org/pub/individual/lib/libxcvt-0.1.3.tar.xz
SRC_SHA256=a929998a8767de7dfa36d6da4751cdbeef34ed630714f2f4a767b351f2442e01
SRC_DIR=libxcvt-0.1.3

# No MESON_ARGS, and that is a fact about the package rather than an omission:
# libxcvt ships NO meson_options.txt at all, so there is no project option to
# state, pin or get wrong. It has no dependency beyond libc either.
#
# Recorded explicitly because "no options" and "options not yet reviewed" look
# identical in a recipe that simply omits the variable, and this tree's habit is
# to state what was decided.
