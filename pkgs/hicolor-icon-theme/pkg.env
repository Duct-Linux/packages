# hicolor-icon-theme -- the directory skeleton every other icon theme inherits
# from, and the place an application drops its own icon. An empty tree of
# directories, and without it icon lookup has no root to fall back to.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://icon-theme.freedesktop.org/releases/hicolor-icon-theme-0.18.tar.xz
SRC_SHA256=db0e50a80aa3bf64bb45cbca5cf9f75efd9348cf2ac690b907435238c3cf81d7
SRC_DIR=hicolor-icon-theme-0.18

PKG_ARCH=any
