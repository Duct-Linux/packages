# libepoxy -- resolves GL entry points at runtime so GTK does not have to know
# at compile time which extensions the driver will turn out to support.
#
# glx and x11 are off to match mesa, which is built without GLX. GTK reaches GL
# through EGL here.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/anholt/libepoxy/archive/1.5.10/libepoxy-1.5.10.tar.gz
SRC_SHA256=a7ced37f4102b745ac86d6a70a9da399cc139ff168ba6b8002b4d8d43c900c15
SRC_DIR=libepoxy-1.5.10

# A GitHub archive URL ends in the bare tag.
SRC_FILE=libepoxy-1.5.10.tar.gz

MESON_ARGS="-Dglx=no -Dx11=false -Degl=yes -Dtests=false"
