# libX11 -- packaged for the components that still link it even in a Wayland
# session. Nothing here runs an X server; this is the client side only.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://www.x.org/pub/individual/lib/libX11-1.8.12.tar.xz
SRC_SHA256=fa026f9bb0124f4d6c808f9aef4057aad65e7b35d8ff43951cef0abe06bb9a9a
SRC_DIR=libX11-1.8.12

# --disable-specs: the protocol specifications are rendered with xmlto, which is
# not packaged, and they are documentation rather than anything that links.
CONFIGURE_ARGS="--disable-static --disable-specs --enable-ipv6 --docdir=/usr/share/doc/libX11-1.8.12"
