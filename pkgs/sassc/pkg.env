# sassc -- the command gtk4 and libadwaita invoke to turn .scss into the CSS
# their themes are actually made of. See libsass/pkg.env for why this is a hard
# requirement rather than a convenience.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
