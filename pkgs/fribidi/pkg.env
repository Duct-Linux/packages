# fribidi -- decides the visual order of mixed left-to-right and right-to-left
# text. Pango requires it; without it Arabic and Hebrew render backwards rather
# than not at all, which is the more embarrassing failure of the two.
#
# Not an LFS package, so it is pinned here rather than in versions.env.
SRC_URL=https://github.com/fribidi/fribidi/releases/download/v1.0.16/fribidi-1.0.16.tar.xz
SRC_SHA256=1b1cde5b235d40479e91be2f0e88a309e3214c8ab470ec8a2744d82a5a9ea05c
SRC_DIR=fribidi-1.0.16

MESON_ARGS="-Ddocs=false -Dtests=false"
