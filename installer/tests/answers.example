# Answers for duct-install-cli, used by the QEMU test.
#
# TEST FIXTURE ONLY. The password is plaintext, which is one of several reasons
# this is a test harness and not unattended installation -- see the comment at
# the top of src/cli/main.c.
#
# Every key is optional. What is left out falls back to the only value v1 can
# actually deliver, which for locale and timezone is the entire range.

[install]
hostname = duct
username = tester
full-name = Duct Test Account
password = hunter2hunter2
root-password-same = true

locale = C.UTF-8
keymap = us
keymap-variant =
timezone = UTC
